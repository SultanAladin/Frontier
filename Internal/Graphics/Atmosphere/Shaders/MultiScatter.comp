#version 450 core

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
//                                                     MULTI-SCATTER LUT 🧩
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// Bakes the isotropic multiple-scattering factor Ψ(r, μ_s) (Hillaire 2020 §multi-scatter): the infinite-series contribution of light that has
// bounced more than once, approximated as isotropic. Output: 32×32 RGBA16F, sun-independent (parameterized by sun-zenith cosine directly).
// X axis = sun-zenith cosine μ_s (-1..1), Y axis = altitude 0→top. Samples the transmittance LUT for the single-scatter estimate per direction.

#include "AtmosphereCommon.glsl"
#include "TransmittanceLookup.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, binding = 2) uniform writeonly image2D MultiScatterOutput;

const int DirectionSamples = 32;   // spherical directions integrated for L_2nd + f_ms
const int MarchSteps       = 20;   // raymarch steps per direction

// 📝 Fibonacci-sphere direction for isotropic integration over the full sphere.
vec3 SphereDirection(int Index, int Count)
{
    float GoldenAngle = 2.399963229728653; // π(3−√5)
    float Z  = 1.0 - 2.0 * (float(Index) + 0.5) / float(Count);
    float R  = sqrt(max(1.0 - Z * Z, 0.0));
    float Phi = float(Index) * GoldenAngle;
    return vec3(R * cos(Phi), Z, R * sin(Phi));
}

void main()
{
    ivec2 Texel  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 Extent = imageSize(MultiScatterOutput);
    if (Texel.x >= Extent.x || Texel.y >= Extent.y)
        return;

    vec2  Uv            = (vec2(Texel) + 0.5) / vec2(Extent);
    float SunZenithCos  = 2.0 * Uv.x - 1.0;
    float Altitude      = Uv.y * (Atmosphere.TopRadius - Atmosphere.BottomRadius);
    float StartRadius   = Atmosphere.BottomRadius + Altitude;

    vec3 SunDir = vec3(sqrt(max(1.0 - SunZenithCos * SunZenithCos, 0.0)), SunZenithCos, 0.0);

    // Accumulate, over a sphere of directions, the second-order in-scatter L_2nd and the multi-scatter transfer f_ms.
    vec3 SecondOrder = vec3(0.0);
    vec3 Transfer    = vec3(0.0);

    for (int DirIndex = 0; DirIndex < DirectionSamples; DirIndex++)
    {
        vec3  ViewDir          = SphereDirection(DirIndex, DirectionSamples);
        float ViewZenithCos    = ViewDir.y;
        vec3  StartPos         = vec3(0.0, StartRadius, 0.0);

        float PathToTop    = IntersectSphere(StartRadius, ViewZenithCos, Atmosphere.TopRadius);
        float PathToGround = IntersectSphere(StartRadius, ViewZenithCos, Atmosphere.BottomRadius);
        float PathLength   = (PathToGround > 0.0) ? PathToGround : max(PathToTop, 0.0);
        if (PathLength <= 0.0) continue;

        float StepSize = PathLength / float(MarchSteps);
        vec3  Throughput = vec3(1.0);

        for (int Step = 0; Step < MarchSteps; Step++)
        {
            float Distance   = (float(Step) + 0.5) * StepSize;
            vec3  SamplePos  = StartPos + ViewDir * Distance;
            float SampleRad  = length(SamplePos);
            float SampleAlt  = SampleRad - Atmosphere.BottomRadius;

            vec3 Scattering, Extinction;
            EvaluateScatterExtinction(SampleAlt, Scattering, Extinction);

            vec3 StepTransmittance = exp(-Extinction * StepSize * 1000.0);

            // Sun-zenith cosine at this sample (relative to local up = normalize(SamplePos)).
            float SampleSunCos = dot(normalize(SamplePos), SunDir);
            vec3  SunTransmit  = SampleTransmittanceToSpace(SampleRad, SampleSunCos);

            // Isotropic phase (1/4π) for the multi-scatter approximation.
            vec3 InScatter = Scattering * (1.0 / (4.0 * PI));

            // Integrate throughput-weighted in-scatter (analytic step integral of S·T).
            vec3 IntegralS      = (Scattering - Scattering * StepTransmittance) / max(Extinction, vec3(1e-6));
            Transfer    += Throughput * IntegralS;
            SecondOrder += Throughput * SunTransmit * InScatter * StepSize * 1000.0;

            Throughput *= StepTransmittance;
        }
    }

    float Norm = 1.0 / float(DirectionSamples);
    SecondOrder *= Norm;
    Transfer    *= Norm;

    // Ψ = L_2nd · 1/(1 − f_ms) — the closed-form sum of the isotropic multiple-scatter geometric series.
    vec3 Psi = SecondOrder / max(vec3(1.0) - Transfer, vec3(1e-3));

    imageStore(MultiScatterOutput, Texel, vec4(Psi, 1.0));
}
