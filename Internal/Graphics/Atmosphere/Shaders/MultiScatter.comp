#version 450
#extension GL_GOOGLE_include_directive : enable

// 🧩 Precompute isotropic multiple-scattering Psi_ms(r, mu_s) using a 64-direction golden-angle spherical Fibonacci quadrature
//    (eliminating polar/azimuthal grid artifacts) and physically cool oceanic/continental surface reflectance.

#include "AtmosphereCommon.glsl"
#include "TransmittanceLookup.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform sampler2D TransmittanceTable;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D MultiScatterTable;

const int   DIRECTION_COUNT = 64;
const int   RAY_STEPS       = 24;
const float GOLDEN_RATIO    = 1.618033988749895;

// Physically cool marine/slate global mean planetary albedo (prevents warm muddy brown multi-scatter haze at sunset).
const vec3  PLANETARY_MEAN_ALBEDO = vec3(0.075, 0.088, 0.105);

void IntegrateSingleDirection(float Radius, vec3 Direction, vec3 SunDirection,
                              out vec3 InScattered, out vec3 FmsTransfer)
{
    float CosineZenith = Direction.y;
    float PathLength   = DistanceToNearestBoundary(Radius, CosineZenith);
    float StepLength   = PathLength / float(RAY_STEPS);

    float CosineSun    = dot(Direction, SunDirection);
    float RayPhase     = RayleighPhase(CosineSun);
    float MiePhase     = CornetteShanksPhase(CosineSun, Atmosphere.MieAsymmetry);
    float UniformPhase = 1.0 / (4.0 * PI);

    vec3 Throughput = vec3(1.0);
    InScattered     = vec3(0.0);
    FmsTransfer     = vec3(0.0);

    for (int Step = 0; Step < RAY_STEPS; ++Step)
    {
        float T          = (float(Step) + 0.5) * StepLength;
        vec3  SamplePos  = vec3(0.0, Radius, 0.0) + Direction * T;
        float SampleR    = length(SamplePos);
        vec3  SampleUp   = SamplePos / SampleR;
        float SampleMuS  = dot(SampleUp, SunDirection);

        vec3 RayleighS, MieS, Extinction;
        EvaluateMediumScattering(SampleR, RayleighS, MieS, Extinction);

        vec3 StepTrans    = exp(-Extinction * StepLength);
        vec3 SafeExt      = max(Extinction, vec3(1.0e-7));
        vec3 StepIntegral = (vec3(1.0) - StepTrans) / SafeExt;

        vec3 SunTrans     = RayIntersectsGround(SampleR, SampleMuS)
                          ? vec3(0.0)
                          : LookupTransmittance(TransmittanceTable, SampleR, SampleMuS);

        vec3 SingleScat   = (RayleighS * RayPhase + MieS * MiePhase) * SunTrans;
        vec3 TotalScat    = RayleighS + MieS;

        InScattered += Throughput * SingleScat * StepIntegral;
        FmsTransfer += Throughput * TotalScat * UniformPhase * StepIntegral;
        Throughput  *= StepTrans;
    }

    if (RayIntersectsGround(Radius, CosineZenith))
    {
        vec3  GroundPos  = vec3(0.0, Radius, 0.0) + Direction * PathLength;
        vec3  GroundUp   = normalize(GroundPos);
        float GroundMuS  = max(0.0, dot(GroundUp, SunDirection));
        if (GroundMuS > 0.0)
        {
            vec3 SunAtGround = LookupTransmittance(TransmittanceTable, Atmosphere.BottomRadius, GroundMuS);
            InScattered += Throughput * SunAtGround * (GroundMuS / PI) * PLANETARY_MEAN_ALBEDO;
        }
    }
}

void main()
{
    ivec2 Size  = imageSize(MultiScatterTable);
    ivec2 Pixel = ivec2(gl_GlobalInvocationID.xy);
    if (Pixel.x >= Size.x || Pixel.y >= Size.y)
        return;

    vec2  Uv           = (vec2(Pixel) + 0.5) / vec2(Size);
    float CosineSunZ   = clamp(Uv.x * 2.0 - 1.0, -1.0, 1.0);
    float Radius       = mix(Atmosphere.BottomRadius + 0.001, Atmosphere.TopRadius - 0.001, Uv.y);
    vec3  SunDirection = vec3(sqrt(max(0.0, 1.0 - CosineSunZ * CosineSunZ)), CosineSunZ, 0.0);

    vec3  L2ndOrder = vec3(0.0);
    vec3  Fms       = vec3(0.0);
    float Weight    = 4.0 * PI / float(DIRECTION_COUNT);

    for (int Index = 0; Index < DIRECTION_COUNT; ++Index)
    {
        float CosTheta  = 1.0 - 2.0 * (float(Index) + 0.5) / float(DIRECTION_COUNT);
        float SinTheta  = sqrt(max(0.0, 1.0 - CosTheta * CosTheta));
        float Phi       = 2.0 * PI * float(Index) / GOLDEN_RATIO;
        vec3  Direction = vec3(SinTheta * cos(Phi), CosTheta, SinTheta * sin(Phi));

        vec3 DirL, DirF;
        IntegrateSingleDirection(Radius, Direction, SunDirection, DirL, DirF);

        L2ndOrder += DirL * Weight;
        Fms       += DirF * Weight;
    }

    const float IsotropicPhase = 1.0 / (4.0 * PI);
    vec3 Psi = (L2ndOrder * IsotropicPhase) / max(vec3(1.0e-4), vec3(1.0) - Fms);
    imageStore(MultiScatterTable, Pixel, vec4(Psi, 1.0));
}
