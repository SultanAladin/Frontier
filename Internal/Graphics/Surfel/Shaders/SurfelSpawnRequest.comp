#version 450
/*==============================================================================================================================================
                                                          SURFELSPAWNREQUEST.COMP
==============================================================================================================================================*/
// 🧩 Pass 1 of the lifecycle spawn (webgiya FindMissing, surfelFindMissingPass.ts). One workgroup owns an 8x8 pixel tile of the visibility buffer.
//    Every lane reconstructs its pixel's world position + flat normal from the packed identity (SurfelVisibilityReconstruct.glsl — the SAME math
//    SurfaceShade.frag uses, NOT a G-buffer read), walks the surfel grid cell that pixel falls in, and measures how well the existing surfels already
//    COVER it. A pixel that is poorly covered and whose cell is not full VOTES to spawn; the workgroup elects ONE winning lane per tile (the least-
//    covered) and that lane writes a single spawn request (worldPos + normal) into the per-tile request buffers. The allocate pass (Pass 2) consumes
//    one request per tile.
//
//    🔴 THE SURFEL ECONOMY (restored — surfelFindMissingPass.ts:406-560). Two `touched`-mailbox writes ride the same per-pixel loop that measures
//       coverage, and they are the pixel-side half of the equilibrium the Age pass enforces:
//         • KEEP-ALIVE — a covered pixel whose cell is not over-subscribed and that finds a well-aligned, same-cell surfel writes atomicMax(touched, 5)
//           to that surfel. Age subtracts that income from the surfel's metabolism, so a surfel that is actively covering geometry ages slower and its
//           cohort no longer recycles in lockstep (the direct fix for the breathing limit cycle).
//         • DESPAWN VOTE — an OVER-covered pixel (tight scoring weight past a fullness-scaled threshold with a strong second-best) elects one winning
//           lane per tile; that lane re-scans its cell for the heaviest surfel and writes atomicMax(touched, 255=KILL) to it. Age's police execution
//           recycles it next frame. This is the pressure-relief valve that stops runaway over-coverage.
//       The irradiance accumulation that seeds new surfels from neighbours' cached light is still deferred (it feeds the allocate, a larger change).
//
//    🔴 The coverage weight (smoothstep(radius, 0, mahalanobis) * max(0, dot(surfelN, pixelN))) and the spawn gate (second-best coverage < 0.4 AND total
//       scoring < 0.1 AND cell not full) are ported 1:1 from surfelFindMissingPass.ts:336-457. The random depth-weighted throttle is kept so spawning
//       stays spread over frames rather than flooding every needy pixel at once.

#include "SurfelGrid.glsl"
#include "SurfelRecord.glsl"
#include "SurfelCoverage.glsl"
#include "SurfelVisibilityReconstruct.glsl"

// 🔴 16x16 = 256 lanes, matching SurfelSpawnTileEdge in SurfelLifecycleSubmission.h — THE TWO MUST BE EDITED TOGETHER. A mismatch does not fail to
//    compile and does not trip the validator: the dispatch simply covers the wrong pixel area, so the pass keeps "working" while sampling the wrong
//    pixels. See that header's note for the full list of what moves with the edge (lane stride + the vote's lane-field width are in this file).
#define SURFEL_SPAWN_TILE_EDGE 16u
layout(local_size_x = 16, local_size_y = 16) in;

// ---- set 0: the visibility reconstruction inputs, mirroring SurfaceShade.frag's set 0 (b0 id, b1/b2/b3 head mesh, b5/b6/b7 floor mesh) ----
layout(set = 0, binding = 0) uniform usampler2D VisibilityBuffer;
layout(std430, set = 0, binding = 1) readonly buffer VertexBlock        { SurfelReconstructVertex   Vertices[]; };
layout(std430, set = 0, binding = 2) readonly buffer IndexBlock         { uint                      Indices[]; };
layout(std140, set = 0, binding = 3) readonly buffer InstanceBlock      { SurfelReconstructInstance Instances[]; };
layout(std430, set = 0, binding = 5) readonly buffer FloorVertexBlock   { SurfelReconstructVertex   FloorVertices[]; };
layout(std430, set = 0, binding = 6) readonly buffer FloorIndexBlock    { uint                      FloorIndices[]; };
layout(std140, set = 0, binding = 7) readonly buffer FloorInstanceBlock { SurfelReconstructInstance FloorInstances[]; };

// ---- set 1: the surfel grid + pool (coverage read), and the per-tile spawn-request outputs ----
layout(std430, set = 1, binding = 0) readonly buffer OffsetsBuffer { int  Offsets[]; };   // per-cell slice [start,end)
layout(std430, set = 1, binding = 1) readonly buffer ListBuffer    { int  List[]; };      // packed per-cell surfel indices
layout(std430, set = 1, binding = 2) readonly buffer SurfelBuffer  { SurfelRecord Surfels[]; };
layout(std430, set = 1, binding = 3) writeonly buffer TileAllocBuffer { int TileAlloc[]; };   // 1 int per tile: 1 == spawn requested this frame
layout(std430, set = 1, binding = 4) writeonly buffer TileCandidateBuffer { vec4 TileCandidate[]; };   // 2 vec4 per tile: [0]=posb(xyz,w frame spare), [1]=normal
layout(std430, set = 1, binding = 5) buffer TouchedBuffer { int Touched[]; };   // per-surfel income mailbox: keep-alive writes 5, despawn writes 255

layout(push_constant) uniform PushBlock
{
    mat4 InverseViewProjection;   // clip -> world (mirrors SurfaceShade.frag ShadeConstants)
    vec4 CameraPosition;          // xyz raw eye; w unused
    vec4 GridOrigin;              // xyz snapped grid origin; w unused
    ivec4 ScreenAndTiles;         // x screen width, y screen height, z tiles-x (grid stride), w frame index
    uint  FloorPartitionBase;     // partition ordinals >= this are floor
    uint  FloorShadeEnabled;      // 1 == floor buffers are real
    uint  FloorIndexBase;         // first index of the floor run in the merged index buffer
    float SpawnDensityScale;      // live spawn-rate multiplier (numpad +/-); 1.0 == the ported baseline throttle
    float TuneCellDiameter;       // live base cell edge (F10 window); seeds from SURFEL_GRID_CELL_DIAMETER
    float TuneBaseRadius;         // live cascade-0 disc radius (F10 window); seeds from SURFEL_BASE_RADIUS
    float TuneNearFieldBias;      // live near-field spawn lift (F10 window); 1.0 == inert baseline
    int   PerCellCap;             // live per-cell fill ceiling (F10 window Apply); == SURFEL_MAX_SURFELS_PER_CELL default
} Push;

// Workgroup vote: pack (coverage score in the high 26 bits, lane index 0..63 in the low 6). atomicMin over the tile finds the LEAST covered lane;
// its float score sorts correctly as a uint because all scores are non-negative. 0xFFFFFFFF is "nobody wants to spawn".
shared uint TileMinVote;
// The despawn counterpart: atomicMax over the tile finds the MOST over-covered lane (the strongest despawn candidate). 0 is "nobody votes to despawn".
shared uint TileMaxVote;

// Economy constants — ported 1:1 from webgiya constants.ts.
const int SURFEL_MAX_SURFELS_PER_CELL_FOR_KEEP_ALIVE = 32;    // maxKeepAlive: the fullness reference + keep-alive cell cap
const int SURFEL_KILL_SIGNAL                         = 255;   // the despawn kill value written into the touched mailbox
const int SURFEL_LIFE_RECYCLE                        = 0x8000000;   // "recycled" marker (a surfel flagged for recycle is not kept alive)

// 🔴 THE DEAD BAND — the cure for a MEASURED two-frame limit cycle. Before this existed the spawn gate fired at ScoringWeight < 0.1 and the despawn
//    vote fired at ScoringWeight > 3.0..3.5, which sounds like a wide gap and is not one: the two gates measure the cell from DIFFERENT PIXELS.
//    Killing the one surfel a well-covered pixel is over-covered BY can drop a neighbouring, poorly-covered pixel straight past the spawn line, so
//    the cell refills, becomes over-covered again, and votes to kill on the very next frame. The census caught it exactly:
//        alive 1018 -> 922 -> 1018 -> 922 ...      spawned 0 -> 96 -> 0 -> 96 ...
//    over 600 frames spawned=25424 vs diedPolice=25224 but diedTtl=only 865 — i.e. 99.2% of all deaths were despawn votes and ~9.4% of the field
//    was recycled EVERY OTHER FRAME. Net population stayed flat at 1018, which is why it never looked like a fault: nothing in the population count
//    moves. The visible symptom is jitter.
//
//    The fix is Falcor SurfelGI's shape (placementThreshold 2.0 / removalThreshold 4.0): spawn strictly BELOW a low bound, kill strictly ABOVE a
//    distinctly higher one, and do NOTHING in between. The band must be wide enough that removing one surfel's contribution cannot carry the cell
//    from above the kill line to below the spawn line, which is what makes the oscillation structurally impossible rather than merely unlikely.
const float SURFEL_SPAWN_COVERAGE_CEILING  = 0.1;   // [-] - spawn only when the TIGHT sum is below this (unchanged; the shipped spawn threshold)
const float SURFEL_DESPAWN_COVERAGE_FLOOR  = 4.0;   // [-] - kill only when the TIGHT sum is above this. Was 3.0..3.5; lifted to open the dead band

// 🔴 YOUNG-SURFEL DESPAWN IMMUNITY — the second half of the cycle break, and the half that acts on the SLOT rather than the cell. The dead band stops
//    a cell from flip-flopping; this stops the specific "spawn -> kill -> spawn" churn on a surfel that has not yet had time to earn its place. A
//    newborn has integrated almost no rays (see SurfelIntegrate's SinceBirth <= 4 ray warmup), so killing it discards work that was never done and
//    the tile immediately re-requests the same spot. Immunity is read from PositionAndSpare.w, which already carries the birth frame all the way from
//    the tile election through SurfelAllocate — no new buffer, no new push field.
const uint SURFEL_DESPAWN_IMMUNE_FRAMES = 8u;   // [-] - a surfel younger than this cannot be picked as a despawn victim

// 🔴 THE LANE FIELD IS 8 BITS BECAUSE THE TILE IS 16x16. It was 6 bits (0x3F) for the 8x8 tile's 64 lanes; 256 lanes do not fit in 6, and a stale mask
//    fails SILENTLY in the worst way — lane 64 aliases onto lane 0, so the tile elects one pixel and the WINNER WRITES A DIFFERENT PIXEL'S world
//    position and normal into the spawn request. The surfel lands somewhere nothing asked for, which reads as scattered bad placement, not as a bug.
//
// 📝 Stealing 8 mantissa bits instead of 6 is safe here: the score is used ONLY to rank lanes inside one tile, never as a value. float32 keeps 23
//    mantissa bits, so this still ranks to ~3e-5 relative — far finer than the coverage differences the election is choosing between — and the bits
//    that are cleared are precisely the ones now carrying the tie-break. Scores are non-negative, so the uint compare orders them correctly.
const uint SURFEL_VOTE_LANE_MASK  = 0xFFu;         // 8 bits — 256 lanes (16x16). Was 0x3Fu for 64 lanes (8x8).
const uint SURFEL_VOTE_SCORE_MASK = 0xFFFFFF00u;   // the complement — the score bits kept above the lane field.

uint SurfelPackVote(float Score, uint Lane)
{
    uint ScoreBits = floatBitsToUint(Score);
    return (ScoreBits & SURFEL_VOTE_SCORE_MASK) | (Lane & SURFEL_VOTE_LANE_MASK);
}

// --- the visibility reconstruction, 1:1 with SurfaceShade.frag:322-416 (identity -> triangle corners -> ray/tri -> flat normal) ---
SurfelSurfaceHit ReconstructPixel(ivec2 Texel)
{
    SurfelSurfaceHit Hit;
    Hit.WorldPosition = vec3(0.0);
    Hit.Normal        = vec3(0.0, 0.0, 1.0);
    Hit.Valid         = false;

    uint Identity = texelFetch(VisibilityBuffer, Texel, 0).r;
    if (Identity == SurfelReconstructSentinel)
        return Hit;

    uint Partition = Identity >> SurfelReconstructPrimitiveBits;
    uint Primitive = Identity & SurfelReconstructPrimitiveMask;

    bool FloorSurface = Partition >= Push.FloorPartitionBase;
    if (FloorSurface && Push.FloorShadeEnabled == 0u)
        return Hit;

    mat4 Model;
    vec3 World0, World1, World2;

    if (FloorSurface)
    {
        uint FloorPartition = Partition - Push.FloorPartitionBase;
        if (FloorPartition >= uint(FloorInstances.length()))
            return Hit;
        Model = FloorInstances[FloorPartition].Model;

        uint IndexBase = Push.FloorIndexBase + Primitive * 3u;
        if (IndexBase + 2u >= uint(FloorIndices.length()))
            return Hit;
        SurfelReconstructVertex V0 = FloorVertices[FloorIndices[IndexBase + 0u]];
        SurfelReconstructVertex V1 = FloorVertices[FloorIndices[IndexBase + 1u]];
        SurfelReconstructVertex V2 = FloorVertices[FloorIndices[IndexBase + 2u]];
        World0 = (Model * vec4(V0.PositionX, V0.PositionY, V0.PositionZ, 1.0)).xyz;
        World1 = (Model * vec4(V1.PositionX, V1.PositionY, V1.PositionZ, 1.0)).xyz;
        World2 = (Model * vec4(V2.PositionX, V2.PositionY, V2.PositionZ, 1.0)).xyz;
    }
    else
    {
        if (Partition >= uint(Instances.length()))
            return Hit;
        Model = Instances[Partition].Model;

        uint IndexBase = Primitive * 3u;
        if (IndexBase + 2u >= uint(Indices.length()))
            return Hit;
        SurfelReconstructVertex V0 = Vertices[Indices[IndexBase + 0u]];
        SurfelReconstructVertex V1 = Vertices[Indices[IndexBase + 1u]];
        SurfelReconstructVertex V2 = Vertices[Indices[IndexBase + 2u]];
        World0 = (Model * vec4(V0.PositionX, V0.PositionY, V0.PositionZ, 1.0)).xyz;
        World1 = (Model * vec4(V1.PositionX, V1.PositionY, V1.PositionZ, 1.0)).xyz;
        World2 = (Model * vec4(V2.PositionX, V2.PositionY, V2.PositionZ, 1.0)).xyz;
    }

    vec2 BufferSize = vec2(float(Push.ScreenAndTiles.x), float(Push.ScreenAndTiles.y));
    vec2 Ndc        = (vec2(Texel) + vec2(0.5)) / BufferSize * 2.0 - 1.0;
    vec3 RayOrigin  = Push.CameraPosition.xyz;
    vec4 NearClip   = Push.InverseViewProjection * vec4(Ndc, 0.0, 1.0);
    vec3 NearPoint  = NearClip.xyz / NearClip.w;
    vec3 RayDir     = normalize(NearPoint - RayOrigin);

    vec3 Bary = SurfelRayTriangleBarycentrics(RayOrigin, RayDir, World0, World1, World2);
    vec3 WorldPosition = Bary.x * World0 + Bary.y * World1 + Bary.z * World2;

    vec3 Normal = normalize(cross(World1 - World0, World2 - World0));
    vec3 ViewVector = normalize(RayOrigin - WorldPosition);
    if (dot(Normal, ViewVector) < 0.0)
        Normal = -Normal;

    Hit.WorldPosition = WorldPosition;
    Hit.Normal        = Normal;
    Hit.Valid         = true;
    return Hit;
}

// A cheap integer hash for the per-pixel spawn throttle (webgiya hash1 / hashCombine2), so spawning is spread over frames.
uint SurfelHashCombine(uint A, uint B)
{
    uint H = A * 747796405u + 2891336453u;
    H = ((H >> ((H >> 28u) + 4u)) ^ H) * 277803737u;
    H ^= B + 0x9E3779B9u + (H << 6u) + (H >> 2u);
    return H;
}

void main()
{
    // Seat the live world-scale globals from the push block BEFORE any grid/radius helper runs (whole-pipeline reach, PLAN §3).
    SurfelSetTuning(Push.TuneCellDiameter, Push.TuneBaseRadius, Push.TuneNearFieldBias);
    SurfelSetPerCellCap(Push.PerCellCap);

    uint LaneIndex = gl_LocalInvocationID.y * SURFEL_SPAWN_TILE_EDGE + gl_LocalInvocationID.x;
    int  TileIndex = int(gl_WorkGroupID.y) * Push.ScreenAndTiles.z + int(gl_WorkGroupID.x);

    if (LaneIndex == 0u)
    {
        TileAlloc[TileIndex] = 0;
        TileMinVote = 0xFFFFFFFFu;
        TileMaxVote = 0u;
    }
    barrier();

    ivec2 Texel = ivec2(gl_GlobalInvocationID.xy);
    bool  InBounds = Texel.x < Push.ScreenAndTiles.x && Texel.y < Push.ScreenAndTiles.y;

    vec3  SpawnPosition = vec3(0.0);
    vec3  SpawnNormal   = vec3(0.0, 0.0, 1.0);

    // Kept for the despawn winner's victim re-scan after the barrier (this pixel's world pos/normal + cell hash).
    vec3 PixelWorld  = vec3(0.0);
    vec3 PixelNormal = vec3(0.0, 0.0, 1.0);
    uint PixelHash   = 0u;
    bool PixelValid  = false;

    if (InBounds)
    {
        SurfelSurfaceHit Hit = ReconstructPixel(Texel);
        if (Hit.Valid)
        {
            SpawnPosition = Hit.WorldPosition;
            SpawnNormal   = Hit.Normal;

            vec3 Relative = Hit.WorldPosition - Push.GridOrigin.xyz;
            uint Hash     = SurfelHashOfPosition(Relative);

            PixelWorld  = Hit.WorldPosition;
            PixelNormal = Hit.Normal;
            PixelHash   = Hash;
            PixelValid  = true;

            int Start = Offsets[int(Hash)];
            int End   = Offsets[int(Hash) + 1];
            int Count = max(End - Start, 0);
            int Loop  = min(Count, SURFEL_MAX_SURFELS_PER_CELL * 2);

            // The coverage measure now comes from SurfelCoverage.glsl so the eviction gate in SurfelAge can threshold the SAME quantity. The
            // arithmetic is unchanged — see that module's extraction note; this loop's shape, bounds and keep-alive side effect are untouched.
            SurfelCoverageTotals Totals = SurfelCoverageBegin();

            for (int I = 0; I < Loop; ++I)
            {
                int Sid = List[Start + I];
                if (Sid < 0) continue;

                SurfelRecord Neighbour = Surfels[Sid];
                vec3  NeighbourPos    = Neighbour.PositionAndSpare.xyz;
                vec3  NeighbourNormal = Neighbour.Normal;

                float SurfelRadius = SurfelRadiusForPositionEye(NeighbourPos, Push.CameraPosition.xyz);
                SurfelCoverageWeights Sample = SurfelCoverageSample(Hit.WorldPosition, Hit.Normal,
                                                                    NeighbourPos, NeighbourNormal, SurfelRadius);
                SurfelCoverageAccumulate(Totals, Sample);

                // KEEP-ALIVE (surfelFindMissingPass.ts:406-416): a covered pixel whose cell is not over-subscribed and that finds a
                // well-aligned, same-cell surfel that is NOT flagged for recycle feeds it a small keep-alive income. Age subtracts this
                // from the surfel's metabolism, so a contributing surfel ages slower and its cohort no longer dies in lockstep.
                bool SameCellKeep = Count <= SURFEL_MAX_SURFELS_PER_CELL_FOR_KEEP_ALIVE
                                    && Sample.DotNormal > 0.8
                                    && SurfelHashOfPosition(NeighbourPos - Push.GridOrigin.xyz) == Hash;
                if (SameCellKeep && Neighbour.Age != SURFEL_LIFE_RECYCLE)
                    atomicMax(Touched[Sid], 5);
            }

            float TotalWeight   = Totals.TotalWeight;
            float ScoringWeight = Totals.ScoringWeight;
            float Second        = Totals.Second;

            // DESPAWN vote (surfelFindMissingPass.ts:422-442): an OVER-covered pixel elects one winning lane per tile. Fullness scales the
            // thresholds toward stricter as the cell fills; a pixel past both the tight-scoring and second-best thresholds packs its scoring
            // weight into the tile's max vote. The winner re-scans below to kill the heaviest surfel.
            float Fullness        = smoothstep(float(SURFEL_MAX_SURFELS_PER_CELL_FOR_KEEP_ALIVE) * 0.75,
                                               float(SURFEL_MAX_SURFELS_PER_CELL_FOR_KEEP_ALIVE),
                                               float(Count));
            // The fullness ramp is kept — a filling cell still gets STRICTER — but both ends now sit above the dead band's floor rather than
            // straddling it. Was mix(3.5, 3.0): the 3.0 end sat close enough to the spawn line to close the band from the kill side.
            float DespawnThreshold = mix(SURFEL_DESPAWN_COVERAGE_FLOOR + 0.5, SURFEL_DESPAWN_COVERAGE_FLOOR, Fullness);
            float SecondThreshold  = mix(0.9, 0.8, Fullness);
            if (ScoringWeight > DespawnThreshold && Second > SecondThreshold)
                atomicMax(TileMaxVote, SurfelPackVote(ScoringWeight, LaneIndex));

            // Spawn gate (surfelFindMissingPass.ts:444-457): a poorly covered pixel whose cell is not full, throttled by a
            // depth-weighted random so the fill spreads over frames rather than flooding.
            //   NEAR-FIELD BIAS (F10 window): the baseline weight = dist/64 makes NEAR pixels spawn LESS. Blending toward a FLAT 1.0
            //   as bias climbs lifts near-field spawn probability without touching the far field's frame-spread. bias 1.0 keeps the
            //   raw ported weight (inert); bias >1 pulls the near field up toward the flat weight. The blend is clamped to [0,1].
            float BaseDepthWeight = length(Hit.WorldPosition - Push.CameraPosition.xyz) / 64.0;
            float BiasLerp        = clamp(g_SurfelNearFieldBias - 1.0, 0.0, 1.0);
            float DepthWeight     = mix(BaseDepthWeight, max(BaseDepthWeight, 1.0), BiasLerp);
            // Live density multiplier (numpad +/-). Guard 0 -> 1 so a host that never set it keeps the ported baseline rather than freezing spawning.
            float DensityScale = Push.SpawnDensityScale > 0.0 ? Push.SpawnDensityScale : 1.0;
            float Probability = 5000.0 * DensityScale * DepthWeight / float(Push.ScreenAndTiles.x) / float(Push.ScreenAndTiles.y);
            uint  Seed        = SurfelHashCombine(SurfelHashCombine(uint(Texel.x), uint(Texel.y)), uint(Push.ScreenAndTiles.w));
            float Random      = float(Seed & 0x00FFFFFFu) / float(0x01000000u);
            bool  RandomOk    = Random < Probability;

            bool GateCoverage = Second < 0.4 && ScoringWeight < SURFEL_SPAWN_COVERAGE_CEILING && Count < g_SurfelPerCellCap;

            // 📝 THE LOTTERY IS A THROUGHPUT THROTTLE. atomicMin over TotalWeight elects the least-covered lane in the tile, but with RandomOk in the
            //    condition it ranks only among LOTTERY SURVIVORS: at 1920x1080 and 10 m an uncovered pixel votes with probability ~1/2600 per frame, so a
            //    64-lane tile expects ~0.024 voters and the election usually has nothing to choose between. Dropping the lottery was tried as an A/B and
            //    REMOVED with the rest of the convergence work; SpawnDensityScale is the live knob that governs this throttle.
            if (GateCoverage && RandomOk)
            {
                // Vote to spawn — the least-covered (lowest total weight) lane wins the tile.
                atomicMin(TileMinVote, SurfelPackVote(TotalWeight, LaneIndex));
            }
        }
    }

    barrier();

    // --- Execute despawn: the winning lane re-scans its cell for the heaviest surfel and flags it for the police execution in Age. ---
    uint DespawnVote = TileMaxVote;
    if (DespawnVote != 0u)
    {
        uint DespawnLane = DespawnVote & SURFEL_VOTE_LANE_MASK;
        if (LaneIndex == DespawnLane && PixelValid)
        {
            int   VictimSid    = -1;
            float VictimWeight = -1.0;

            int Start = Offsets[int(PixelHash)];
            int End   = Offsets[int(PixelHash) + 1];
            int Count = max(End - Start, 0);
            int Loop  = min(Count, SURFEL_MAX_SURFELS_PER_CELL * 2);

            for (int I = 0; I < Loop; ++I)
            {
                int Sid = List[Start + I];
                if (Sid < 0) continue;

                SurfelRecord Neighbour = Surfels[Sid];
                vec3  NeighbourPos    = Neighbour.PositionAndSpare.xyz;
                vec3  NeighbourNormal = Neighbour.Normal;

                // 🔴 YOUNG-SURFEL IMMUNITY — see SURFEL_DESPAWN_IMMUNE_FRAMES. A surfel this young has integrated almost no rays (SurfelIntegrate
                //    floors a newborn at 32 samples for its first 4 frames), so killing it throws away work that was never done AND leaves the cell
                //    just as uncovered as before — the tile re-requests the same spot next frame, which is the churn half of the limit cycle. Skipping
                //    it here does NOT cancel the despawn: the loop simply elects the best ELIGIBLE victim, and if every candidate is immune the cell
                //    keeps its surfels for a few frames and re-votes once they have earned their keep.
                //    Unsigned is correct — the birth frame is always <= the current frame, so the difference cannot wrap. An untouched slot reads
                //    w == 0 and therefore looks "young" for the first few frames of the very first run only, which is harmless: a recycled slot is
                //    always re-stamped by SurfelAllocate before it can be picked.
                uint NeighbourBirthFrame = uint(max(Neighbour.PositionAndSpare.w, 0.0));
                uint NeighbourAgeFrames  = uint(Push.ScreenAndTiles.w) - NeighbourBirthFrame;
                if (NeighbourAgeFrames < SURFEL_DESPAWN_IMMUNE_FRAMES)
                    continue;

                float SurfelRadius = SurfelRadiusForPositionEye(NeighbourPos, Push.CameraPosition.xyz);
                // The victim pick uses the LOOSE weight, matching the vote that elected this lane. Same module, same arithmetic as the measure loop.
                SurfelCoverageWeights Sample = SurfelCoverageSample(PixelWorld, PixelNormal,
                                                                    NeighbourPos, NeighbourNormal, SurfelRadius);
                float Weight = Sample.Weight;

                if (Weight >= VictimWeight) { VictimWeight = Weight; VictimSid = Sid; }
            }

            if (VictimSid != -1)
                atomicMax(Touched[VictimSid], SURFEL_KILL_SIGNAL);
        }
    }

    // The winning lane (if any) writes the one per-tile spawn request.
    uint Winner = TileMinVote;
    if (Winner != 0xFFFFFFFFu)
    {
        uint WinningLane = Winner & SURFEL_VOTE_LANE_MASK;
        if (LaneIndex == WinningLane)
        {
            TileAlloc[TileIndex] = 1;
            TileCandidate[TileIndex * 2 + 0] = vec4(SpawnPosition, float(Push.ScreenAndTiles.w));   // w = frame (posb spare)
            TileCandidate[TileIndex * 2 + 1] = vec4(SpawnNormal, 0.0);
        }
    }
}
