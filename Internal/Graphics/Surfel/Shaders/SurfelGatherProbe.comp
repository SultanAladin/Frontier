#version 450
/*==============================================================================================================================================
                                                          SURFELGATHERPROBE.COMP
==============================================================================================================================================*/
// 🧩 VALIDATION-ONLY probe for the Phase-3 gather. It stands the surfel set up exactly as SurfaceShade.frag / SurfelIntegrate.comp do, then calls the
//    SHIPPED SurfelLookupGI at a set of host-supplied world points and writes each returned irradiance into a result buffer the gate reads back. This
//    is the "reading the output proves nothing" guard for the seam the shade depends on: the gate seeds a known irradiance into a known cell, runs the
//    real slotting, dispatches this probe, and asserts a point inside a surfel's radius returns that irradiance (weighted) while a far point returns 0.
//
//    🔴 IT DECLARES THE SAME SEVEN SURFEL BUFFERS the gather's leaf modules reach for by bare name — Surfels/Moments/Offsets/List (read by the gather),
//       Guiding/Depth (read+written by SurfelGuiding.glsl / SurfelRadialDepth.glsl, which compile in even though the gather calls only the depth path),
//       Touched (atomicMax'ed). Same layout the integrate uses, so the two agree. Single descriptor set (set 0) — the probe needs no BVH.
//
//    🔴 THE READ-OFFSET IS A PUSH FIELD, NOT parity-derived here: the gate passes the RIGHT read half for the pass assertion and the WRONG half (write,
//       zero-filled) for the control, so the same shipped kernel produces the load-bearing divergence the plan demands.
//
//    ⚠️ Compiled by glslc THROUGH ShaderPlan.ps1's .comp glob; the five #include'd .glsl reach the compiler only through this file. glslc -I, never
//       glslangValidator. Do NOT stage this into a shipping build's Shaders dir — it is a gate probe.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SurfelRecord's layout must exist before the buffer block names it (same reason the integrate pulls it in early).
#include "SurfelRecord.glsl"

// The moments struct: five vec4 rows (20 floats) — byte-identical to SurfelIntegrate.comp's SurfelMomentEntry and the host DeviceMoment.
struct SurfelMomentEntry
{
    vec4 Irradiance;   // xyz = mean irradiance, w = totalCount
    vec4 MsmeData0;    // xyz = shortMean,       w = vbbr
    vec4 MsmeData1;    // xyz = variance,        w = inconsistency
    vec4 Hit;          // xyz = first hit point, w = debug flag
    vec4 Guiding;      // xyz = mean world dir,  w = slgMass
};

layout(std430, set = 0, binding = 0) readonly buffer SurfelBuffer  { SurfelRecord      Surfels[]; };
layout(std430, set = 0, binding = 1)          buffer MomentsBuffer { SurfelMomentEntry SurfelMoments[]; };
layout(std430, set = 0, binding = 2) readonly buffer OffsetsBuffer { int   SurfelOffsets[]; };
layout(std430, set = 0, binding = 3) readonly buffer ListBuffer    { int   SurfelList[]; };
layout(std430, set = 0, binding = 4)          buffer GuidingBuffer { float SurfelGuidingBuffer[]; };
layout(std430, set = 0, binding = 5)          buffer DepthBuffer   { vec4  SurfelDepthBuffer[]; };
layout(std430, set = 0, binding = 6)          buffer TouchedBuffer { int   SurfelTouched[]; };

// The probe points + the answers. One lane per point; PointCount lanes do work, the rest early-out.
layout(std430, set = 0, binding = 7) readonly buffer ProbePointBuffer  { vec4 ProbePoints[]; };   // xyz = world shade point, w unused
layout(std430, set = 0, binding = 8) readonly buffer ProbeNormalBuffer { vec4 ProbeNormals[]; };  // xyz = world normal at that point, w unused
layout(std430, set = 0, binding = 9)          buffer ResultBuffer      { vec4 GatherResult[]; };  // xyz = returned irradiance, w = 1 (written flag)

layout(push_constant) uniform GatherProbeConstants
{
    vec4 CameraPosition;    // xyz raw eye (the radius model measures from it); w unused
    vec4 GridOrigin;        // xyz snapped grid origin (matches the slotting build); w unused
    vec4 OcclusionParams;   // (shadowStrength, bleedReduction, grazingBiasScale, varianceBleedScale)
    uint ReadOffsetElements;// [-] - moments read-half element base = parity*Capacity (the gate passes the RIGHT half; the control passes the WRONG one)
    uint PointCount;        // [-] - number of probe points to evaluate
    // 📝 Was Pad0. Spent on the frame index the gather's newborn fade-in needs, so the block SIZE and every other field's offset are unchanged — a host
    //    that has not been taught to fill it pushes 0, which reads as "every surfel is old" and gives exactly the pre-fade-in behaviour. That is the
    //    right failure mode for a diagnostic probe: it cannot silently invent a fade the shade path is not also applying.
    uint Frame;             // [-] - current frame index (newborn fade-in); 0 == fade disabled
    uint Pad1;
} Constants;

// The grid + module chain the gather calls, in dependency order (SurfelRecord already pulled in above; its guard makes the re-include a no-op).
#include "SurfelGrid.glsl"
#include "SurfelGuiding.glsl"
#include "SurfelRadialDepth.glsl"
#include "SurfelGather.glsl"

void main()
{
    uint Index = gl_GlobalInvocationID.x;
    if (Index >= Constants.PointCount) { return; }

    vec3 Point  = ProbePoints[Index].xyz;
    vec3 Normal = normalize(ProbeNormals[Index].xyz);

    vec3 Gi = SurfelLookupGI(Point, Normal, Constants.CameraPosition.xyz, Constants.GridOrigin.xyz,
                             Constants.ReadOffsetElements, Constants.OcclusionParams, Constants.Frame);

    GatherResult[Index] = vec4(Gi, 1.0);
}
