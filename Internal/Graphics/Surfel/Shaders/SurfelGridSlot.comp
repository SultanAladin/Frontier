#version 450
/*==============================================================================================================================================
                                                          SURFELGRIDSLOT.COMP
==============================================================================================================================================*/
// 🧩 Final pass of the grid build: scatter each live surfel's index into its cells' list slices. After the scan, Offsets[h] holds cell h's END offset
//    (one past the last slot of its slice). This pass, for every cell a surfel intersects, atomicAdd(-1) on Offsets[h] to claim the top slot of that
//    cell's slice and writes the surfel index there — filling each slice back-to-front. The mirror of the count pass: same surfel liveness gate, same
//    box iteration, same intersection test, so the exact set of (surfel, cell) pairs the count tallied is the set the slot fills.
//
//    🔴 Ported 1:1 from webgiya surfelHashGrid.ts:574-702 (computeSlot). Atomic-decrement strategy: atomicAdd returns the value BEFORE subtraction, so
//       writeIdx = returned - 1 is the slot to write. 🔴 F6 SPLIT: webgiya's merged buffer writes the list at OFFSETS_AND_LIST_START + writeIdx; with the
//       list SPLIT into its own SSBO the bias is gone — the list index IS writeIdx. The bounds guard becomes writeIdx in [0, ListCount): a torn scan or a
//       cell over-subscribed past its cap can hand back a negative or out-of-range slot, which is silently dropped exactly as the reference drops it.

#include "SurfelGrid.glsl"
#include "SurfelRecord.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer OffsetsBuffer { int Offsets[]; };            // atomic: per-cell END offset (this pass decrements)
layout(std430, binding = 1) readonly buffer SurfelBuffer { SurfelRecord Surfels[]; };
layout(std430, binding = 2) readonly buffer PoolMaxBuffer { int PoolMax[]; };   // [0] = pool high-water slot count
layout(std430, binding = 3) writeonly buffer ListBuffer { int List[]; };        // per-slice surfel indices (F6: standalone SSBO)

layout(push_constant) uniform PushBlock
{
    vec4  CameraPosition;    // xyz raw camera world position; w unused
    vec4  GridOrigin;        // xyz snapped grid origin; w unused
    int   ListCount;         // capacity of the List SSBO (bounds guard)
    float TuneCellDiameter;  // live base cell edge (F10 window)
    float TuneBaseRadius;    // live cascade-0 disc radius (F10 window)
    float TuneNearFieldBias; // live near-field bias (F10 window; unused by slot)
} Push;

void main()
{
    // Seat the live world-scale globals before the grid box + intersection math (whole-pipeline reach; must match count exactly).
    SurfelSetTuning(Push.TuneCellDiameter, Push.TuneBaseRadius, Push.TuneNearFieldBias);

    int Index = int(gl_GlobalInvocationID.x);
    int Total = PoolMax[0];
    if (Index >= Total) return;

    SurfelRecord Surfel = Surfels[Index];
    if (Surfel.Age >= SURFEL_TTL) return;

    vec3  WorldPosition = Surfel.PositionAndSpare.xyz;
    vec3  Normal        = Surfel.Normal;
    vec3  Relative      = WorldPosition - Push.GridOrigin.xyz;
    float Radius        = SurfelRadiusForPositionEye(WorldPosition, Push.CameraPosition.xyz);

    SurfelGridBox Box = SurfelGridBoxMinMax(Relative);

    for (int Ci = 0; Ci < Box.CascadeCount; ++Ci)
    {
        ivec4 CurrentMin = (Ci == 1) ? Box.C1Min : Box.C0Min;
        ivec4 CurrentMax = (Ci == 1) ? Box.C1Max : Box.C0Max;
        uint  Cascade    = uint(CurrentMin.w);

        for (int Z = CurrentMin.z; Z <= CurrentMax.z; ++Z)
        for (int Y = CurrentMin.y; Y <= CurrentMax.y; ++Y)
        for (int X = CurrentMin.x; X <= CurrentMax.x; ++X)
        {
            uvec4 Cell = uvec4(uint(X), uint(Y), uint(Z), Cascade);
            if (SurfelIntersectsGridCoord(WorldPosition, Normal, Radius, Cell, Push.GridOrigin.xyz))
            {
                uint Hash       = SurfelCellToHash(Cell);
                int  EndPlusOne = atomicAdd(Offsets[int(Hash)], -1);   // value BEFORE the subtract
                int  WriteIndex = EndPlusOne - 1;
                if (WriteIndex >= 0 && WriteIndex < Push.ListCount)
                    List[WriteIndex] = Index;
            }
        }
    }
}
