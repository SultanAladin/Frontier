#version 450
/*==============================================================================================================================================
                                                     SURFELPREFIXSCANSEGMENT.COMP
==============================================================================================================================================*/
// 🧩 Pass 1 of 4 of the segmented inclusive prefix sum over the grid's per-cell counts. Each workgroup owns one SEGMENT_SIZE-wide slice of the
//    Offsets buffer and computes a segment-LOCAL inclusive scan of it in shared memory, writing the scanned values back in place. The segment sums
//    are stitched together by the following three passes (Collect → SegPrefix → Merge) so the final Offsets hold a global inclusive prefix.
//
//    🔴 Ported 1:1 from webgiya surfelHashGrid.ts:485-529 (computeScanSeg). One thread owns TWO consecutive elements (idx2 = lid*2), so 512 threads
//       cover the 1024-wide segment. The step loop runs STEP_COUNT = log2(WORKGROUP_SIZE)+1 = 10 times; the read/write index arithmetic (rd/wr/mask)
//       is transcribed verbatim — it is a Brent-Kung-style up-sweep and the index math is load-bearing, do not "simplify" it. Out-of-range lanes read
//       0 (identity for +) so a partial final segment scans correctly. The neighbour value is snapshotted into a register before the add, matching the
//       reference's .toVar() — reading and accumulating the same shared slot in one statement would race.

layout(local_size_x = 512) in;

const int SURFEL_SCAN_WORKGROUP_SIZE = 512;
const int SURFEL_SCAN_SEGMENT_SIZE   = SURFEL_SCAN_WORKGROUP_SIZE * 2;   // 1024
const int SURFEL_SCAN_STEP_COUNT     = 10;                               // log2(512) + 1

layout(std430, binding = 0) buffer OffsetsBuffer { int Offsets[]; };     // in/out: per-cell counts -> segment-local inclusive scan

layout(push_constant) uniform PushBlock
{
    int ElementCount;   // totalCells + 1 (the number of live entries; lanes past this read 0)
} Push;

shared int Shared[SURFEL_SCAN_SEGMENT_SIZE];

void main()
{
    int Lid  = int(gl_LocalInvocationID.x);
    int Seg  = int(gl_WorkGroupID.x);
    int Base = Seg * SURFEL_SCAN_SEGMENT_SIZE;
    int Idx2 = Lid * 2;

    int G0 = Base + Idx2;
    int G1 = G0 + 1;
    bool In0 = G0 < Push.ElementCount;
    bool In1 = G1 < Push.ElementCount;

    Shared[Idx2]     = In0 ? Offsets[G0] : 0;
    Shared[Idx2 + 1] = In1 ? Offsets[G1] : 0;
    barrier();

    for (int Step = 0; Step < SURFEL_SCAN_STEP_COUNT; ++Step)
    {
        int Mask = (1 << Step) - 1;
        int Rd   = ((Lid >> Step) << (Step + 1)) + Mask;
        int Wr   = Rd + 1 + (Lid & Mask);
        bool Ok  = (Rd < SURFEL_SCAN_SEGMENT_SIZE) && (Wr < SURFEL_SCAN_SEGMENT_SIZE);
        if (Ok)
        {
            int NeighborValue = Shared[Rd];   // snapshot before the RMW (reference .toVar())
            Shared[Wr] += NeighborValue;
        }
        barrier();
    }

    if (In0) Offsets[G0] = Shared[Idx2];
    if (In1) Offsets[G1] = Shared[Idx2 + 1];
}
