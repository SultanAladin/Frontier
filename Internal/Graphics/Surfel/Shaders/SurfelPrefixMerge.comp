#version 450
/*==============================================================================================================================================
                                                         SURFELPREFIXMERGE.COMP
==============================================================================================================================================*/
// 🧩 Pass 4 of 4. Lift every segment-local inclusive scan into a GLOBAL inclusive prefix by adding the running total of all PRIOR segments. Element i
//    lives in segment s = i / SEGMENT_SIZE; if s > 0 it gets SegmentSums[s-1] (the inclusive prefix through the previous segment, from pass 3) added
//    to its already-segment-local-scanned value. Segment 0 is already correct and is left alone.
//
//    🔴 Ported 1:1 from webgiya surfelHashGrid.ts:555-571 (computeMerge). One invocation per Offsets element; guarded by idx < ElementCount and s > 0.
//       After this pass Offsets holds the exact inclusive prefix sum a CPU std::partial_sum would produce — that is the gate the validation exe checks.

layout(local_size_x = 256) in;

const int SURFEL_SCAN_WORKGROUP_SIZE = 512;
const int SURFEL_SCAN_SEGMENT_SIZE   = SURFEL_SCAN_WORKGROUP_SIZE * 2;   // 1024

layout(std430, binding = 0) buffer OffsetsBuffer     { int Offsets[]; };
layout(std430, binding = 1) buffer SegmentSumsBuffer { int SegmentSums[]; };

layout(push_constant) uniform PushBlock
{
    int ElementCount;   // totalCells + 1
} Push;

void main()
{
    int Index = int(gl_GlobalInvocationID.x);
    if (Index >= Push.ElementCount) return;

    int Seg = Index / SURFEL_SCAN_SEGMENT_SIZE;
    if (Seg > 0)
    {
        Offsets[Index] += SegmentSums[Seg - 1];
    }
}
