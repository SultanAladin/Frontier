#version 450
/*==============================================================================================================================================
                                                              SURFELAGE.COMP
==============================================================================================================================================*/
// 🧩 Pass that ages every live surfel one frame and recycles the ones that hit TTL (webgiya Age / "Surfel Economy", surfelAgePass.ts). One lane per
//    pool slot, up to the high-water mark PoolMax[0]. A live surfel (age < TTL) ages +1; if that pushes it to TTL it is DECLARED DEAD — its age is
//    stamped SURFEL_LIFE_RECYCLED and its slot is pushed back onto the free-list (atomicAdd(-1) on the stack pointer, write the slot at the freed
//    position). The recycled slot is then available to the next allocate.
//
//    🔴 PHASE-1 REDUCTION. webgiya's Age also runs a "police execution" on a KILL signal, a crowding "rent" that ages surfels faster where a cell is
//       over-subscribed, and reads the per-frame `touched` income — all through the `touched` scoring channel that Phase 1 only ZERO-FILLS. Those are
//       Phase-2 economy; here age is a plain +1 metabolism and TTL is the only death. The recycle-to-free-list mechanic (the part Phase 1's lifecycle
//       DoD tests) is ported exactly.
//
//    🔴 Dispatched over the pool CAPACITY (one lane per slot, gated by PoolMax[0]), NOT an indirect count. webgiya drives Age with an indirect dispatch
//       sized to the live count; Frontier's slotting count/slot passes already dispatch over capacity and gate on PoolMax, so this matches them. The
//       indirect-dispatch optimisation is deferred to Phase 2 (it only saves idle lanes, it changes no result).

#include "SurfelRecord.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer SurfelBuffer    { SurfelRecord Surfels[]; };
layout(std430, binding = 1) buffer PoolBuffer      { int PoolFreeList[]; };
layout(std430, binding = 2) buffer PoolAllocBuffer { int PoolAlloc[]; };   // stack pointer atomic
layout(std430, binding = 3) buffer PoolMaxBuffer   { int PoolMax[]; };     // high-water atomic (read only here)

layout(push_constant) uniform PushBlock { int Capacity; } Push;

const int SURFEL_TTL           = 500;
const int SURFEL_LIFE_RECYCLED = 0x8000000 + 1;

void main()
{
    int Index = int(gl_GlobalInvocationID.x);
    int Total = PoolMax[0];
    if (Index >= Total) return;

    int Age = Surfels[Index].Age;
    if (Age >= SURFEL_TTL) return;   // already dead / recycled — leave it

    int NextAge = Age + 1;           // Phase-1 metabolism: +1 per frame
    Surfels[Index].Age = NextAge;

    if (NextAge >= SURFEL_TTL)
    {
        // Death: stamp recycled and return the slot to the free-list stack.
        Surfels[Index].Age = SURFEL_LIFE_RECYCLED;
        int FreedSlot = atomicAdd(PoolAlloc[0], -1) - 1;   // value BEFORE the subtract, minus one
        if (FreedSlot >= 0 && FreedSlot < Push.Capacity)
            PoolFreeList[FreedSlot] = Index;
    }
}
