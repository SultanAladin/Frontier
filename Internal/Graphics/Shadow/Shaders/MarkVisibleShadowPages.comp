#version 450
// ============================================================================================================================================
//                                                       MARKVISIBLESHADOWPAGES.COMP
// ============================================================================================================================================
// 🧩 S1 — receiver-driven tile marking. One invocation per screen pixel: reconstruct that pixel's world position, find the light-space tile it
//    falls in at the level its distance warrants, and raise `Used | Direct` on that tile. This is what decides which shadow pages must EXIST;
//    S2 separately decides which of them hold WRONG depth. Nothing here says anything about staleness.
//
// 🔴 READS THE ID BUFFER, NOT DEPTH, AND THE DIFFERENCE IS NOT STYLISTIC. Where nothing rasterized, depth holds its clear value; reconstructing
//    from that yields a far-plane point which marks distant tiles across the whole sky, and at the coarsest LODs that is a large fraction of the
//    window — the pool would be exhausted by empty background. `VisibilityEmptySentinel` (0xFFFFFFFF) is unambiguous, needs no epsilon, and
//    survives a future reverse-Z switch, which the depth-clear convention does not.
//
// ⚠️ Marking is `atomicOr` only, from thousands of uncoordinated invocations. A bit may only ever be RAISED here — there is no read-modify-write
//    that could lower another invocation's bit — so this pass needs no synchronization at all, and the per-image clear must happen BEFORE it
//    (ResetShadowTileDemand), never inside it.

#extension GL_GOOGLE_include_directive : require
#include "ShadowTileStore.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// The packed surface identity per pixel. Sampled (not storage) because this pass only reads it, and the id target is already SAMPLED for the resolve.
layout(set = 0, binding = 1) uniform usampler2D VisibilityBuffer;

// Scene depth, D32 sampled. ⚠️ Used ONLY to reconstruct position for pixels the id buffer already proved are covered — never as the coverage test.
layout(set = 0, binding = 2) uniform sampler2D SceneDepth;

layout(push_constant) uniform MarkConstants
{
    mat4  InverseViewProjection;   // [-]     - clip -> world, same matrix SurfaceShade.frag unprojects with
    vec4  LightRightAxis;          // [-]     - light-space +X in world (w unused)
    vec4  LightUpAxis;             // [-]     - light-space +Y in world (w unused)
    vec4  ObserverPosition;        // [m]     - ⚠️ NO LONGER READ — see SelectShadowLevel. Kept so the std140 layout still mirrors the C++ struct.
    ivec2 ScreenExtent;            // [px]    - width/height; out-of-range invocations early-out
    float BaseTileMetres;          // [m]     - LOD 0 tile edge; doubles per level
    uint  LevelCount;              // [-]     - LODs to consider
    uint  EmptySentinel;           // [-]     - the id value meaning "nothing rasterized here"
    float LodDistanceScale;        // [m]     - ⚠️ NO LONGER READ. The level now follows the clipmap window's own geometry (BaseTileMetres * Resolution),
                                   //           so a separate hand-tuned distance cannot disagree with it. Kept for the std140 mirror.
} Constants;

// The per-level toroidal origins, one per level, in a small uniform block rather than the push constants: the 64-byte matrix plus the vectors above
// already sit close to the 128-byte guaranteed push limit on Pascal, and six more origins would not fit.
// ⚠️ std140 rounds any array element up to 16 bytes, so an `ivec2[6]` would occupy the same 96 bytes as this `ivec4[6]` while hiding the padding.
//    Declaring the padding is what keeps the C++ mirror honest.
layout(set = 0, binding = 3, std140) uniform ShadowLevelBlock
{
    ivec4 LevelOrigin[ShadowTilemapLodCount];   // .xy = that level's ToroidalOrigin; .zw unused (std140 pads to 16 either way)
} Levels;

// 📝 One tile of guard band, so a level's boundary sits INSIDE its valid data. Mirrors SunShadowTrace.glsl's ShadowTraceLevelNarrowing exactly.
#define MarkLevelNarrowing (float(ShadowTilemapResolution) / (float(ShadowTilemapResolution) - 1.0001))

// 📝 The level whose tile size suits a receiver at this LIGHT-SPACE OFFSET FROM THE CLIPMAP CENTRE. Each level doubles its world tile edge, so the index
//    is the log2 of the offset expressed in L0 windows — `ceil` so the chosen level always CONTAINS the receiver.
//
// 🔴 THIS MUST STAY BIT-FOR-BIT THE SAME DECISION AS SunShadowTrace.glsl's SelectShadowTraceLevel, AND NOTHING IN THE BUILD CHECKS IT. Marking decides
//    which pages get ALLOCATED; the tracer decides which page it READS. If the two disagree, the tracer asks for a level marking never requested a page
//    for — the tile is unmapped, the walk falls outward, and the receiver resolves to a coarser page or comes out lit. The reference implementations make
//    this structural by calling one shared function from both passes; this codebase cannot (the two stages share no include), so the invariant is carried
//    by these comments and must be re-checked whenever either side changes.
//
// 🔴 MEASURED FROM THE CLIPMAP CENTRE, NOT FROM THE EYE, AND THAT IS THE FIX FOR THE MOTION ARTEFACTS. The previous form divided an EYE distance by
//    LodDistanceScale, so every receiver's level moved when the camera merely rotated: at Distance = 18 m a yaw sweep displaces the eye +-18 m in light
//    space, and zooming drove `floor(log2(dist/8))` directly — a power-of-two staircase that resolved the whole window to one coarse level. A stationary
//    receiver's level changed frame to frame with no geometric cause, which is the flicker.
// ⚠️ CHEBYSHEV (per-axis max), not `length()`: the window is a SQUARE, and a Euclidean test under-reports the extent off-axis, handing a diagonal
//    receiver a level whose window excludes it. Same reasoning and the same measurement as the tracer's copy.
uint SelectShadowLevel(vec2 LateralMetres, vec2 CentreMetres)
{
    const float BaseHalfSpan = Constants.BaseTileMetres * float(ShadowTilemapResolution) * 0.5;
    if (BaseHalfSpan <= 0.0)
        return 0u;

    const vec2  Offset       = abs(LateralMetres - CentreMetres);
    const float OffsetMetres = max(Offset.x, Offset.y) * MarkLevelNarrowing;

    const float Ratio = OffsetMetres / BaseHalfSpan;
    if (Ratio <= 1.0)
        return 0u;

    return min(uint(ceil(log2(Ratio))), Constants.LevelCount - 1u);
}

// This level's window centre in light-space METRES, recovered from its toroidal origin (ADD form: corner is -Origin, centre is -Origin + Resolution/2).
// Mirrors SunShadowTrace.glsl's ResolveShadowTraceCentreMetres.
vec2 ResolveMarkCentreMetres(ivec2 ToroidalOrigin, uint Level)
{
    const float TileMetres = Constants.BaseTileMetres * float(1u << Level);
    const vec2  CentreTile = vec2(-ToroidalOrigin) + vec2(float(ShadowTilemapResolution) * 0.5);

    return CentreTile * TileMetres;
}

void main()
{
    const ivec2 Texel = ivec2(gl_GlobalInvocationID.xy);
    if (Texel.x >= Constants.ScreenExtent.x || Texel.y >= Constants.ScreenExtent.y)
        return;

    // 🔴 The coverage test, and the whole reason this pass samples the id buffer. An uncovered pixel contributes NOTHING — no tile, no page.
    const uint Identity = texelFetch(VisibilityBuffer, Texel, 0).r;
    if (Identity == Constants.EmptySentinel)
        return;

    // Reconstruct the receiver's world position. Vulkan NDC: x,y in [-1,1] with y DOWN, z in [0,1] — matching SurfaceShade.frag's UnprojectPixel.
    const vec2  PixelCentre = (vec2(Texel) + vec2(0.5)) / vec2(Constants.ScreenExtent);
    const vec2  Ndc         = PixelCentre * 2.0 - 1.0;
    const float NdcDepth    = texelFetch(SceneDepth, Texel, 0).r;

    const vec4 Clip = Constants.InverseViewProjection * vec4(Ndc, NdcDepth, 1.0);
    if (abs(Clip.w) < 1e-12)
        return;                       // a degenerate unprojection would place the receiver anywhere; marking nothing is the safe answer
    const vec3 WorldPosition = Clip.xyz / Clip.w;

    // Project into the light plane. 🔴 Only the two lateral axes matter: the tile lattice is 2D in LIGHT space, and the forward axis is DEPTH, which
    //    the atlas stores per texel rather than addressing tiles by. Using a world-axis projection here would ignore the sun's rotation entirely.
    const float LightX = dot(WorldPosition, Constants.LightRightAxis.xyz);
    const float LightY = dot(WorldPosition, Constants.LightUpAxis.xyz);

    // 🔴 THE LEVEL IS CHOSEN FROM THE LIGHT-SPACE OFFSET, so it is computed AFTER the projection above rather than from the world position — the same
    //    quantity the tracer selects on. The centre comes from L0's origin for the reason SunShadowTrace.glsl documents: every level floors the same
    //    observer position at its own tile size, so the centres differ by up to a tile, and L0's is the most precise of the six.
    const vec2 CentreMetres = ResolveMarkCentreMetres(Levels.LevelOrigin[0].xy, 0u);
    const uint Level        = SelectShadowLevel(vec2(LightX, LightY), CentreMetres);

    // This level's world tile edge, doubling per level.
    const float TileMetres = Constants.BaseTileMetres * float(1u << Level);

    // 🔴 An arithmetic FLOOR, not a truncating cast. Light-space coordinates are routinely negative (the lattice is centred on the observer, not the
    //    world origin), and `int(x)` truncates toward zero — so every receiver left of or below the origin would land one tile high, shifting half
    //    the marked set by a tile. `floor()` then casting is correct for both signs.
    const ivec2 LightTile = ivec2(int(floor(LightX / TileMetres)),
                                  int(floor(LightY / TileMetres)));

    const uint WordIndex = ResolveShadowTileWordIndex(Level, LightTile, Levels.LevelOrigin[Level].xy);

    // 🔴 Raises Direct as well as Used, because this is a RECEIVER asking. Propagation (S3) raises Used WITHOUT Direct, and tile masking depends on
    //    exactly that distinction — masking on the Coarse bit alone would drop a page this pixel is reading.
    RaiseShadowTileBits(WordIndex, ShadowTileUsedBit | ShadowTileDirectBit);
}
