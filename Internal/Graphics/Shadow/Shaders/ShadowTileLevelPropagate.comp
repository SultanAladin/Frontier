#version 450
// ============================================================================================================================================
//                                                      SHADOWTILELEVELPROPAGATE.COMP
// ============================================================================================================================================
// 🧩 S3 — carry demand up the LOD chain. One workgroup per level, one invocation per tile of that level: a tile that is wanted at level N makes
//    the tile covering it at level N+1 wanted too, tagged as INHERITED. After this pass every resident coarse tile that any finer tile depends on
//    is backed, so the tracer always has a coarser fallback when a fine page is missing.
//
// 🔴 THE DIRECTION IS FINE → COARSE, AND THE OPPOSITE DIRECTION IS NOT A SYMMETRIC CHOICE. Coarse → fine would mark FOUR children per parent per
//    level and exhaust the 256-page pool on the first image. Fine → coarse marks at most one parent per tile and shrinks by 4x per level. The
//    coarse tile is the tracer's SAFETY NET, not an equal partner: it is read when the fine page it wanted was never allocated.
//
// 🔴 LEVELS MUST BE WALKED IN ASCENDING ORDER, AND NOTHING IN THIS SHADER CAN ENFORCE THAT. Level N's own inherited demand must be visible when level
//    N+1 is processed, or LOD 0's demand stops at LOD 1 instead of reaching LOD 5. Vulkan gives no ordering between workgroups and `barrier()` only
//    synchronizes WITHIN one, so the ordering lives entirely in the recorder: 🔴 DISPATCH THIS SHADER ONCE PER LEVEL, ascending, with a
//    vkCmdPipelineBarrier (SHADER_WRITE -> SHADER_READ) between consecutive dispatches. `gl_GlobalInvocationID.z` selects the level, so each dispatch is
//    1 x 1 x 1 with a baseGroupZ of the level — a single 1 x 1 x LevelCount dispatch would run all six levels concurrently and propagate only one
//    level deep, nondeterministically. The pipeline must also carry VK_PIPELINE_CREATE_DISPATCH_BASE_BIT, or the non-zero base is invalid outright.
//
// ⚠️ Raises Used|Coarse and NEVER Direct. Direct means "a receiver samples this tile itself" and only S1 may claim that. Tile masking tests
//    `Coarse && !Direct` to find purely-inherited demand; raising Direct here would make every propagated tile look receiver-visible and masking
//    would never fire at all.

#extension GL_GOOGLE_include_directive : require
#include "ShadowTileStore.glsl"

// 🔴 32 x 32 = 1024 invocations, exactly one per tile of a level — and exactly Pascal's maxComputeWorkGroupInvocations floor. There is NO headroom:
//    adding a z of 2 to sweep two levels per group would request 2048 and fail workgroup creation on the minimum-spec device. The level comes from
//    gl_WorkGroupID.z instead, which costs nothing.
layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

// The per-level toroidal origins — the same block S1 binds, so one descriptor set serves the whole marking chain.
layout(set = 0, binding = 3, std140) uniform ShadowLevelBlock
{
    ivec4 LevelOrigin[ShadowTilemapLodCount];   // .xy = that level's ToroidalOrigin; .zw unused (std140 pads to 16 regardless)
} Levels;

layout(push_constant) uniform PropagateConstants
{
    uint LevelCount;   // [-] - LODs in the clipmap; the top level has no coarser parent and only reads
} Constants;

void main()
{
    // 🔴 gl_GlobalInvocationID.z, NOT gl_WorkGroupID.z. The recorder selects the level with vkCmdDispatchBase's baseGroupZ, and the Vulkan spec does
    //    NOT fold that base into WorkgroupId — it stays the base-RELATIVE group index, so with a 1 x 1 x 1 dispatch it is always 0. Reading it here made
    //    all six per-level dispatches process level 0, so demand reached level 1 and stopped: measured as coarse-only 0 on every image, with
    //    TileUsedCount == TileDirectCount exactly, which looks like "propagation is broken" and not like "the level index is always zero".
    //    GlobalInvocationId is defined as WorkgroupId * WorkgroupSize + LocalInvocationId + the dispatch base, so its .z carries the level; local_size_z
    //    is 1, so .z is exactly baseGroupZ.
    const uint Level = gl_GlobalInvocationID.z;
    if (Level >= Constants.LevelCount)
        return;

    // 🔴 The TOP level has no parent. Returning early here is not merely an optimization: ResolveShadowTileWordIndex(LevelCount, ...) would index
    //    past this level's word range into whatever follows, and with LevelCount == ShadowTilemapLodCount that is past the buffer entirely.
    if (Level + 1u >= Constants.LevelCount)
        return;

    const ivec2 Slot = ivec2(gl_LocalInvocationID.xy);

    // 🔴 The light tile resident in this physical slot is `Slot - Origin`, NOT `Origin + Slot`. ToroidalOrigin is stored in ADD form (the negated
    //    window corner), so this is the inverse of ResolveShadowTileWordIndex's add. Both forms enumerate all 32 slots bijectively, so getting it
    //    backwards passes every in-range and every bijection check and still names a DIFFERENT set of light tiles — whose halved ancestors then fall
    //    outside the coarse window and propagation reaches zero coarse tiles. Measured, on the CPU mirror: 0/32 with the wrong form, 32/32 with this.
    const ivec2 FineOrigin = Levels.LevelOrigin[Level].xy;
    const ivec2 FineTile   = Slot - FineOrigin;

    const uint FineWordIndex = ResolveShadowTileWordIndex(Level, FineTile, FineOrigin);
    const uint FineWord      = ReadShadowTileWord(FineWordIndex);

    // Only demand propagates. ⚠️ Deliberately tests Used and not ShadowTileRequestsPage: masking runs AFTER this pass, so no tile is masked yet, and
    // reading the Masked bit here would couple two passes that are ordered the other way round.
    if ((FineWord & ShadowTileUsedBit) == 0u)
        return;

    const ivec2 CoarseTile      = ResolveCoarserShadowTile(FineTile);
    const uint  CoarseWordIndex = ResolveShadowTileWordIndex(Level + 1u, CoarseTile, Levels.LevelOrigin[Level + 1u].xy);

    // ⚠️ No barrier follows this write, deliberately. The only reader of it is the NEXT level's dispatch, and cross-dispatch visibility comes from the
    //    recorder's pipeline barrier — an in-shader memoryBarrierBuffer() here would synchronize nothing and imply a guarantee this pass cannot make.
    RaiseShadowTileBits(CoarseWordIndex, ShadowTileUsedBit | ShadowTileCoarseBit);
}
