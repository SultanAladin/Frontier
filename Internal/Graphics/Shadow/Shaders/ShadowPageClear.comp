#version 450
// ============================================================================================================================================
//                                                          SHADOWPAGECLEAR.COMP
// ============================================================================================================================================
// 🧩 S6 — prime the pages S7 is about to rasterize into. Writes ShadowPageClearIdentity (0xFFFFFFFF) to every texel of every page in the render
//    list, and nothing else. One workgroup covers a 32x32 texel patch; the dispatch's z selects which page of the list this group belongs to.
//
// 🔴 THIS PASS IS NOT AN OPTIMIZATION OF "CLEAR THE ATLAS" — CLEARING THE WHOLE ATLAS WOULD BE WRONG, not merely slow. The pool's entire purpose is
//    that a CACHED page keeps depth from an earlier image so a scrolling camera does not re-rasterize it. A full 64 MiB vkCmdClearColorImage would
//    wipe every cached page each image, so every page would come back stale, S7 would redraw all 256 of them, and the cache would be dead weight —
//    the shadows would still look correct, which is exactly why this would survive an image comparison and only show up as a frame-time cliff.
//
// 🔴 THE CLEAR VALUE AND THE ATOMIC IDENTITY ARE THE SAME CONSTANT, AND MUST STAY SO. S7 resolves casters with imageAtomicMin, whose identity is
//    UINT_MAX; a texel left holding anything else would win the min against real caster depth and read as a caster floating at that depth. Clearing
//    to 0 is the worst case — 0 is the NEAREST depth, so every unwritten texel becomes a caster pressed against the light and the receiver falls into
//    full shadow everywhere nothing was drawn. This is why the clear cannot be skipped for a freshly-allocated page either: a page straight from the
//    free list holds whatever the last owner rasterized, and imageAtomicMin against uninitialized memory resolves to garbage depth, not "no caster".
//
// ⚠️ The render list is PAGE INDICES, not slots. A page's atlas rectangle is derived from its own index (row-major in a 16x16 page grid) and has
//    nothing to do with which tile currently owns it — going through the tile mapping here would clear the page a tile points at TODAY, which is the
//    same page but reached by a longer route that breaks the moment a slot is remapped between the list being built and this pass running.

// ⚠️ DELIBERATELY INCLUDES NOTHING. ShadowTileStore.glsl declares the tile table as a storage buffer at set 0 binding 0, which is where this pass binds
//    the atlas image — including it would either collide outright or force this unit's bindings to shift to accommodate a table it never reads. S6
//    addresses pages by index and needs no tile flag, no toroidal origin, and no word layout. Every quantity it needs arrives by push constant.

// 📝 32 x 32 = 1024 invocations, Pascal's maxComputeWorkGroupInvocations floor, matching ShadowPoolWorkgroupEdge. A 256-texel page edge is exactly
//    8 groups across, so the page divides evenly and no invocation is wasted on a partial patch.
layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

// The atlas as a write-only integer image. ⚠️ r32ui, and the format qualifier is not decorative — it is what makes imageStore's uint overload legal.
layout(set = 0, binding = 0, r32ui) uniform writeonly uimage2D ShadowAtlas;

// The pages to clear, densely packed: entry i is a physical page index. 📝 Dense, so gl_WorkGroupID.z indexes it directly and the dispatch's z extent
// IS the count — there is no "is this page in the list" test anywhere in this shader, and no branch that can disagree with the CPU's selection.
layout(set = 0, binding = 1, std430) readonly buffer ShadowClearListBlock
{
    uint PageIndex[];
} ClearList;

layout(push_constant) uniform ClearConstants
{
    uint PageCount;        // [page]  - entries in the list; z is dispatched to exactly this, so the bound is belt-and-braces
    uint PageResolution;   // [texel] - page edge, ShadowPageResolution
    uint AtlasPageEdge;    // [page]  - pages per atlas edge, ShadowPageAtlasPageEdge
    uint ClearValue;       // [-]     - ShadowPageClearIdentity; passed rather than hardcoded so C++ owns the one definition
    uint PageCapacity;     // [page]  - ShadowPageCapacity; the containment bound for a list entry
} Constants;

void main()
{
    // ⚠️ WorkGroupID.z here, not GlobalInvocationID.z — this dispatch has a zero base (unlike S3's per-level baseGroupZ), and local_size_z is 1, so the
    //    two agree. WorkGroupID is the honest expression of "which page of the list", since z indexes pages and not texels.
    const uint ListSlot = gl_WorkGroupID.z;
    if (ListSlot >= Constants.PageCount)
        return;

    const uint Page = ClearList.PageIndex[ListSlot];

    // A page index past the pool would compute an in-bounds-looking atlas rectangle that overlaps a real page, so this is a containment gate and not a
    // debug assert: a corrupt entry must clear NOTHING rather than another page's depth.
    if (Page >= Constants.PageCapacity)
        return;

    // The page's top-left texel. Row-major over the page grid, the same layout ResolveShadowPageOrigin computes on the CPU.
    const uvec2 PageOrigin = uvec2((Page % Constants.AtlasPageEdge) * Constants.PageResolution,
                                   (Page / Constants.AtlasPageEdge) * Constants.PageResolution);

    // Where inside the page this group's patch sits.
    const uvec2 PatchTexel = gl_GlobalInvocationID.xy;
    if (PatchTexel.x >= Constants.PageResolution || PatchTexel.y >= Constants.PageResolution)
        return;

    imageStore(ShadowAtlas, ivec2(PageOrigin + PatchTexel), uvec4(Constants.ClearValue, 0u, 0u, 0u));
}
