#version 450
// ============================================================================================================================================
//                                                        SOFTWARERASTERIZATION.COMP
// ============================================================================================================================================
// 🧩 The software micro-raster of the hybrid visibility path (PLAN §6). One compute invocation owns ONE triangle of the instanced Suzanne scene:
//    it fetches the triangle's three vertices as SSBOs (the same device-local vertex/index buffers the hardware raster binds), transforms them
//    through the push-constant ViewProjection into clip → screen space, walks the triangle's screen-space AABB testing edge-function coverage per
//    pixel, and for every covered pixel packs a 64-bit (DepthKey << 32) | Identity word and resolves overlap with a single atomicMax. DepthKey is
//    built so a NEARER surface yields the LARGER key, so atomicMax keeps exactly the nearest identity — the same occlusion the hardware depth test
//    resolves, done in one atomic. Identity is packed IDENTICALLY to VisibilityRaster.frag ((PartitionId << 20) | (PrimitiveId & 0xFFFFF)), so the
//    resolve that follows is byte-for-byte agnostic to which raster produced the word — that is what makes the two paths A/B-verifiable and
//    id-identical. No colour, no texture, no material — id + depth only (Burns & Hunt 2013).
//
//    THE 3-BAND HYBRID (Nanite's SW raster). A triangle's cost scales with its screen-space AABB area, so binning triangles by that area lets each
//    band spend the right amount of parallelism (Wihlidal / Karis, "A Deep Dive into Nanite", 2021):
//      • THREAD band  — tiny triangles (AABB area <= ThreadBandArea px): one thread rasterizes the whole triangle serially. The micro-triangle
//                       common case; a serial pixel walk over a handful of pixels beats any cooperation overhead.
//      • SUBGROUP band — medium triangles (<= SubgroupBandArea px): the subgroup cooperates, each lane striding across the AABB's pixels so the
//                       triangle's rows are covered in parallel without a full workgroup barrier.
//      • SPLIT band    — large triangles (> SubgroupBandArea px): too big for one invocation to walk within budget; the whole workgroup strides the
//                       AABB in a 2D grid, every invocation covering a disjoint pixel subset. (Nanite hands these to the HARDWARE raster; here we
//                       keep them on the compute path behind the whole-workgroup stride so the software path stays self-contained and A/B-exact.)
//    All three bands share ONE coverage+depth+atomicMax core (ShadePixel); the bands differ only in WHICH invocation covers WHICH pixels. The band
//    is chosen per triangle from its AABB area, so a single dispatch handles the full size spread with no host-side sorting.

// A modest square workgroup: the SPLIT band strides the AABB as an 8x8 tile so a workgroup covers 64 pixels per step; the THREAD/SUBGROUP bands
// use the same 64 lanes as a flat subgroup. gl_SubgroupSize may be < 64 on some hardware, so the SUBGROUP band strides by the real subgroup size.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_ARB_gpu_shader_int64 : require

// The packed-target routes. Exactly one is compiled in per pipeline via these specialization-style defines the host sets through the shader
// variant it loads: PACKED_ROUTE_IMAGE for the R64_UINT storage image (imageAtomicMax), PACKED_ROUTE_BUFFER for the R64 SSBO (atomicMax on a
// buffer element). Both carry the identical (DepthKey<<32)|Identity word, so only the atomic target differs.
#ifndef PACKED_ROUTE_IMAGE
#define PACKED_ROUTE_IMAGE 0
#endif
#ifndef PACKED_ROUTE_BUFFER
#define PACKED_ROUTE_BUFFER 0
#endif

// int64 atomics on the compiled-in target. The image route needs GL_EXT_shader_image_int64 (the u64image2D type + imageAtomicMax); the buffer
// route needs GL_EXT_shader_atomic_int64 (atomicMax on a uint64_t SSBO element). Guarded so each variant pulls in only the extension its target
// route uses — which is exactly the device feature VulkanHost enabled for that route.
#if PACKED_ROUTE_IMAGE
#extension GL_EXT_shader_image_int64 : require
#endif
#if PACKED_ROUTE_BUFFER
#extension GL_EXT_shader_atomic_int64 : require
#endif

// One placed head, mirroring SuzanneSceneInstance / VisibilityRaster.vert's SceneInstance (std140): column-major model matrix, a normal basis and
// tint (unused here), the partition identity, the shade pass's material index, and the std140 tail pad. The CPU instance list uploads straight into
// this buffer. MaterialId is unused on this path too, but the slot must match or the padding after it shifts.
// 🔴 MIRRORS SuzanneSceneInstance (Graphics/Scene/SuzanneScene.h) FIELD FOR FIELD — 208 bytes. Three other shaders carry the same hand-written copy
//    (VisibilityRaster.vert, SurfaceShade.frag, ComponentOverlay.frag). A copy that falls behind the C++ struct still compiles and still validates;
//    it just strides by the wrong size, so instance N reads the tail of instance N-1. The host static_assert is what catches it.
struct SceneInstance
{
    mat4 Model;          // column-major world transform
    vec4 NormalBasis[3]; // unused at this phase
    vec4 Tint;           // unused here
    uint PartitionId;    // instance identity
    uint MaterialId;     // index into the SurfacePresetTable — unused here, read by the shade pass
    uint MeshOrdinal;    // bottom-level tree slice — ray tracing only, unused here
    uint Pad0;
    mat4 InverseModel;   // world -> local, for the ray trace — unused here
};

// One RenderVertex, stride-32: position @0 (vec3), normal @12 (vec3), texcoord @24 (vec2). We read only the position; declaring the whole layout
// keeps the std430 stride at 32 so PositionForVertex indexes correctly. The host binds the SAME device-local vertex buffer the hardware raster
// uses as a vertex buffer — here as an SSBO (BufferAllocation added STORAGE usage for exactly this).
struct RenderVertex
{
    float PositionX; float PositionY; float PositionZ; // @0
    float NormalX;   float NormalY;   float NormalZ;   // @12 (unused)
    float TexU;      float TexV;                       // @24 (unused)
};

// set 0, binding 0 — per-instance transforms + identity (std140, matching the hardware raster's InstanceBlock).
layout(std140, set = 0, binding = 0) readonly buffer InstanceBlock
{
    SceneInstance Instances[];
};

// set 0, binding 1 — the GPU cull's survivor list (one instance index per survivor slot). Read exactly like the hardware raster: when culling is
// active gl_WorkGroup lanes index a survivor SLOT and the real instance is Survivors[slot]; when off the slot IS the instance index.
layout(std430, set = 0, binding = 1) readonly buffer SurvivorBlock
{
    uint Survivors[];
};

// set 0, binding 2 — the mesh vertex stream as an SSBO (position read per triangle corner).
layout(std430, set = 0, binding = 2) readonly buffer VertexBlock
{
    RenderVertex Vertices[];
};

// set 0, binding 3 — the mesh index stream as an SSBO (three indices per triangle).
layout(std430, set = 0, binding = 3) readonly buffer IndexBlock
{
    uint Indices[];
};

// set 0, binding 4 — the packed atomicMax target. Storage-image route: an R64_UINT image, imageAtomicMax at the pixel. Buffer route: an R64 SSBO
// of Width*Height words, atomicMax at the linear index. Only the compiled-in route is declared.
#if PACKED_ROUTE_IMAGE
layout(set = 0, binding = 4, r64ui) uniform coherent u64image2D PackedImage;
#endif
#if PACKED_ROUTE_BUFFER
layout(std430, set = 0, binding = 4) buffer PackedBufferBlock
{
    uint64_t PackedWords[];
};
#endif

// Push data: the camera the triangle projects through, the viewport extent (clip → screen), how many instances the dispatch spans, the triangle
// count per instance, and the survivor-remap selector. Mirrors the hardware raster's constants plus the software raster's dispatch bounds.
layout(push_constant) uniform SoftwareRasterConstants
{
    mat4 ViewProjection;    // [-]  - world -> clip (column-major, matches the hardware raster)
    vec2 ViewportExtent;    // [px] - target width/height for the clip -> screen map
    uint InstanceCount;     // [-]  - number of instances this dispatch covers (survivor count when culling, else instance count)
    uint TriangleCount;     // [-]  - triangles per instance (index count / 3)
    uint CullActive;        // [-]  - 0 = the group's instance slot IS the instance index; 1 = remap through Survivors[]
    uint Pad0;
    uint Pad1;
    uint Pad2;
} Constants;

// The identity pack — MUST match VisibilityRaster.frag exactly so the resolve is producer-agnostic. Partition in the high 12 bits, primitive in
// the low 20.
const uint PrimitiveBits = 20u;
const uint PrimitiveMask = (1u << PrimitiveBits) - 1u;

// The one band threshold by screen-space AABB area (pixels): at or below it a triangle is the THREAD band (one lane walks it alone); above it the
// triangle is rasterized cooperatively by its owning subgroup. Tuned for the micro-triangle common case — most subdivided-Suzanne triangles fall
// in the THREAD band, so the expensive cooperative broadcast is reserved for the genuinely large triangles (near-camera heads, the floor slab).
const float ThreadBandArea = 64.0;   // <= 8x8 px: one lane walks it serially; larger cooperates across the subgroup

// A packed word from a depth key and an identity. DepthKey occupies the high 32 bits so atomicMax orders primarily by depth; identity fills the
// low 32. Built as a 64-bit value so the shift does not overflow.
uint64_t PackWord(uint DepthKey, uint Identity)
{
    return (uint64_t(DepthKey) << 32) | uint64_t(Identity);
}

// Map an NDC depth in [0,1] (standard Vulkan clip: 0 = near, 1 = far) to a DepthKey where NEARER yields a LARGER key, so atomicMax keeps the
// nearest surface. Invert and scale across the full 32-bit range: key = round((1 - depth) * 0xFFFFFFFF). A depth exactly at the near plane maps to
// the max key; the far plane to zero (matching VisibilityPackedEmptySentinel, so an uncovered pixel never beats a real surface).
uint DepthToKey(float NdcDepth)
{
    float Clamped = clamp(NdcDepth, 0.0, 1.0);
    return uint((1.0 - Clamped) * 4294967295.0);
}

// The world-space position of a mesh vertex.
vec3 PositionForVertex(uint VertexIndex)
{
    RenderVertex Vertex = Vertices[VertexIndex];
    return vec3(Vertex.PositionX, Vertex.PositionY, Vertex.PositionZ);
}

// atomicMax the packed word into whichever route is compiled in. The pixel's linear index is only needed by the buffer route.
void AtomicMaxPacked(ivec2 Pixel, uint LinearIndex, uint64_t Word)
{
#if PACKED_ROUTE_IMAGE
    imageAtomicMax(PackedImage, Pixel, Word);
#endif
#if PACKED_ROUTE_BUFFER
    atomicMax(PackedWords[LinearIndex], Word);
#endif
}

// ─── The shared coverage + depth + atomicMax core ───
// Given a pixel and the triangle's three screen-space vertices (xy in pixels, z = NDC depth, w = clip w for perspective-correct depth), test
// edge-function coverage; if covered, interpolate depth with the barycentric weights, build the packed word, and atomicMax it. Every band routes
// through here — the bands differ only in which invocation calls it for which pixel.
struct ScreenTriangle
{
    vec3 A;    // xy = screen px, z = NDC depth
    vec3 B;
    vec3 C;
    float InverseArea; // 1 / (signed edge-function area), precomputed once per triangle
    bool  Valid;       // false = degenerate / fully clipped: skip
};

// Signed area of the triangle edge function (twice the area). Positive for CCW in screen space (y-down after the clip→screen flip).
float EdgeArea(vec2 P0, vec2 P1, vec2 P2)
{
    return (P1.x - P0.x) * (P2.y - P0.y) - (P1.y - P0.y) * (P2.x - P0.x);
}

void ShadePixel(ivec2 Pixel, ScreenTriangle Tri, uint Identity)
{
    if (Pixel.x < 0 || Pixel.y < 0 || Pixel.x >= int(Constants.ViewportExtent.x) || Pixel.y >= int(Constants.ViewportExtent.y))
        return;

    vec2 Sample = vec2(float(Pixel.x) + 0.5, float(Pixel.y) + 0.5);

    // Three edge functions; a pixel is inside when all three share the triangle's winding sign. Using the precomputed InverseArea's sign keeps
    // both windings covered without a separate front/back test (the visibility buffer stores whatever triangle wins depth, like the HW raster).
    float W0 = EdgeArea(Tri.B.xy, Tri.C.xy, Sample);
    float W1 = EdgeArea(Tri.C.xy, Tri.A.xy, Sample);
    float W2 = EdgeArea(Tri.A.xy, Tri.B.xy, Sample);
    bool AllPositive = (W0 >= 0.0 && W1 >= 0.0 && W2 >= 0.0);
    bool AllNegative = (W0 <= 0.0 && W1 <= 0.0 && W2 <= 0.0);
    if (!AllPositive && !AllNegative)
        return;

    // Barycentric weights (normalized by the signed area). Interpolate NDC depth linearly in screen space — the same depth the hardware raster's
    // fixed-function interpolation writes for a linear-z target, keeping the two paths depth-identical.
    float BaryA = W0 * Tri.InverseArea;
    float BaryB = W1 * Tri.InverseArea;
    float BaryC = W2 * Tri.InverseArea;
    float Depth = BaryA * Tri.A.z + BaryB * Tri.B.z + BaryC * Tri.C.z;

    uint      DepthKey = DepthToKey(Depth);
    uint64_t  Word     = PackWord(DepthKey, Identity);
    uint      Linear   = uint(Pixel.y) * uint(Constants.ViewportExtent.x) + uint(Pixel.x);
    AtomicMaxPacked(Pixel, Linear, Word);
}

// Project one triangle (given its three world positions and the instance model) to screen space, returning a ScreenTriangle. Marks Valid=false
// when any vertex is behind the near plane (clip.w <= 0) — a full near-clip is out of scope for this phase's micro-raster, and a partially-clipped
// triangle is conservatively skipped by the software path (the hardware path covers it; the A/B toggle compares only the unclipped common case).
ScreenTriangle ProjectTriangle(mat4 Model, vec3 P0, vec3 P1, vec3 P2)
{
    ScreenTriangle Tri;
    Tri.Valid = false;

    vec4 Clip0 = Constants.ViewProjection * (Model * vec4(P0, 1.0));
    vec4 Clip1 = Constants.ViewProjection * (Model * vec4(P1, 1.0));
    vec4 Clip2 = Constants.ViewProjection * (Model * vec4(P2, 1.0));
    if (Clip0.w <= 0.0 || Clip1.w <= 0.0 || Clip2.w <= 0.0)
        return Tri;

    vec3 Ndc0 = Clip0.xyz / Clip0.w;
    vec3 Ndc1 = Clip1.xyz / Clip1.w;
    vec3 Ndc2 = Clip2.xyz / Clip2.w;

    // NDC xy [-1,1] → screen px [0,extent]; Vulkan's clip space is y-down, so screen y = (ndc.y * 0.5 + 0.5) * height with no extra flip. NDC z is
    // already [0,1] and used directly as the depth key input.
    Tri.A = vec3((Ndc0.x * 0.5 + 0.5) * Constants.ViewportExtent.x, (Ndc0.y * 0.5 + 0.5) * Constants.ViewportExtent.y, Ndc0.z);
    Tri.B = vec3((Ndc1.x * 0.5 + 0.5) * Constants.ViewportExtent.x, (Ndc1.y * 0.5 + 0.5) * Constants.ViewportExtent.y, Ndc1.z);
    Tri.C = vec3((Ndc2.x * 0.5 + 0.5) * Constants.ViewportExtent.x, (Ndc2.y * 0.5 + 0.5) * Constants.ViewportExtent.y, Ndc2.z);

    float Area = EdgeArea(Tri.A.xy, Tri.B.xy, Tri.C.xy);
    if (abs(Area) < 1e-6)
        return Tri;   // degenerate / zero-area after projection
    Tri.InverseArea = 1.0 / Area;
    Tri.Valid = true;
    return Tri;
}

// The triangle's screen-space AABB clamped to the viewport, as integer pixel bounds [Min, Max] inclusive.
void TriangleBounds(ScreenTriangle Tri, out ivec2 MinPixel, out ivec2 MaxPixel)
{
    vec2 Lo = min(min(Tri.A.xy, Tri.B.xy), Tri.C.xy);
    vec2 Hi = max(max(Tri.A.xy, Tri.B.xy), Tri.C.xy);
    MinPixel = ivec2(clamp(floor(Lo), vec2(0.0), Constants.ViewportExtent - 1.0));
    MaxPixel = ivec2(clamp(ceil(Hi),  vec2(0.0), Constants.ViewportExtent - 1.0));
}

// ─── Band walkers ───
//
// The correctness rule for cooperation: a subgroup's lanes each OWN a different triangle, so a walker that strides by the subgroup size is only
// valid when every cooperating lane is working the SAME triangle. The bands honour that:
//   • THREAD band  — no cooperation. The owning lane walks its whole AABB alone. Safe regardless of what its neighbours own.
//   • SUBGROUP band — genuine cooperation, but SERIALIZED PER TRIANGLE: the subgroup visits each large-triangle owner in turn (a ballot of who is
//                     in the band, iterated), broadcasts that owner's triangle to ALL lanes, and every lane strides the SHARED AABB. Because the
//                     triangle is identical across the subgroup for that step, striding by gl_SubgroupSize covers disjoint pixels with no gaps.
//   • SPLIT band   — the same serialized-per-triangle cooperation at workgroup width is out of scope here (it needs a barrier + shared memory to
//                     broadcast across subgroups); a SPLIT-band triangle is instead cooperatively rasterized by its OWNING subgroup exactly like
//                     the subgroup band (all lanes stride the shared AABB), which is correct and keeps the path barrier-free. The 8x8 workgroup
//                     still gives up to two/three subgroups of parallelism across different large triangles.

// One lane walks its whole triangle's AABB serially. No cooperation — used by the THREAD band and as the per-triangle core the cooperative bands
// broadcast into (there each lane instead strides, so this exact loop is only the thread-band path).
void RasterizeSerial(ScreenTriangle Tri, uint Identity)
{
    ivec2 MinPixel, MaxPixel;
    TriangleBounds(Tri, MinPixel, MaxPixel);
    for (int Y = MinPixel.y; Y <= MaxPixel.y; ++Y)
        for (int X = MinPixel.x; X <= MaxPixel.x; ++X)
            ShadePixel(ivec2(X, Y), Tri, Identity);
}

// All lanes of the subgroup cooperatively rasterize ONE shared triangle: each lane strides the flattened AABB by the subgroup size, so the pixels
// are partitioned across lanes with no gaps and no overlap. The triangle + identity are identical across the subgroup for this call (broadcast by
// the caller), which is exactly what makes the strided partition valid.
void RasterizeCooperative(ScreenTriangle Tri, uint Identity)
{
    ivec2 MinPixel, MaxPixel;
    TriangleBounds(Tri, MinPixel, MaxPixel);
    uint SpanX = uint(MaxPixel.x - MinPixel.x + 1);
    uint SpanY = uint(MaxPixel.y - MinPixel.y + 1);
    uint Total = SpanX * SpanY;
    for (uint Flat = gl_SubgroupInvocationID; Flat < Total; Flat += gl_SubgroupSize)
    {
        int X = MinPixel.x + int(Flat % SpanX);
        int Y = MinPixel.y + int(Flat / SpanX);
        ShadePixel(ivec2(X, Y), Tri, Identity);
    }
}

// Resolve the (instanceSlot, triangle) this global invocation owns, project the triangle, choose its band by AABB area, and rasterize.
// One invocation owns one triangle; the flat global id spans InstanceCount * TriangleCount.
void main()
{
    // One invocation owns one triangle. The host dispatches ceil(Total / 64) workgroups assuming 64 triangles per group, but this workgroup is an
    // 8x8x1 tile (64 invocations laid out 2D so the SPLIT band can stride pixels as a tile). gl_GlobalInvocationID.x therefore only spans
    // WorkGroupCount.x * 8 — one eighth of the lanes — so keying the triangle off .x alone silently drops 7/8 of every dispatch (≈ one head's worth
    // survives, with holes where triangle density is highest). Flatten the full 64-lane group instead: gl_LocalInvocationIndex is the dense
    // 0..63 flatten of the 8x8 tile, and gl_WorkGroupID.x * 64 offsets it per group — a unique triangle per invocation across the whole dispatch.
    uint Flat  = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    uint Total = Constants.InstanceCount * Constants.TriangleCount;
    bool Live  = Flat < Total;

    // Per-lane triangle setup (guarded so out-of-range lanes stay to participate in the subgroup ballot below without touching memory).
    ScreenTriangle Tri;
    Tri.Valid = false;
    uint Identity = 0u;
    float AabbArea = 0.0;
    if (Live)
    {
        uint InstanceSlot = Flat / Constants.TriangleCount;
        uint Triangle     = Flat % Constants.TriangleCount;

        uint InstanceIndex = (Constants.CullActive != 0u) ? Survivors[InstanceSlot] : InstanceSlot;
        SceneInstance Instance = Instances[InstanceIndex];

        uint I0 = Indices[Triangle * 3u + 0u];
        uint I1 = Indices[Triangle * 3u + 1u];
        uint I2 = Indices[Triangle * 3u + 2u];

        Tri = ProjectTriangle(Instance.Model,
                              PositionForVertex(I0),
                              PositionForVertex(I1),
                              PositionForVertex(I2));
        if (Tri.Valid)
        {
            Identity = (Instance.PartitionId << PrimitiveBits) | (Triangle & PrimitiveMask);
            ivec2 MinPixel, MaxPixel;
            TriangleBounds(Tri, MinPixel, MaxPixel);
            AabbArea = float(MaxPixel.x - MinPixel.x + 1) * float(MaxPixel.y - MinPixel.y + 1);
        }
    }

    // THREAD band: tiny triangles each lane finishes alone, right now, in parallel across the subgroup.
    bool ThreadBand = Tri.Valid && AabbArea <= ThreadBandArea;
    if (ThreadBand)
        RasterizeSerial(Tri, Identity);

    // COOPERATIVE band: every triangle above the thread threshold (subgroup + split alike) is rasterized by the whole subgroup, one owner at a
    // time. Ballot the lanes that still have a large triangle, then for each such lane broadcast its triangle to the subgroup and stride it
    // cooperatively. Iterating the ballot serializes the large triangles but parallelizes each one's pixels across all lanes — the Nanite trade
    // that keeps big triangles off the slow one-lane walk. The loop is uniform across the subgroup (every lane sees the same ballot), so the
    // subgroup broadcasts are well-defined.
    uvec4 LargeBallot = subgroupBallot(Tri.Valid && !ThreadBand);
    while (subgroupBallotBitCount(LargeBallot) > 0u)
    {
        uint Owner = subgroupBallotFindLSB(LargeBallot);

        ScreenTriangle Shared;
        Shared.A           = subgroupShuffle(Tri.A, Owner);
        Shared.B           = subgroupShuffle(Tri.B, Owner);
        Shared.C           = subgroupShuffle(Tri.C, Owner);
        Shared.InverseArea = subgroupShuffle(Tri.InverseArea, Owner);
        Shared.Valid       = true;
        uint SharedIdentity = subgroupShuffle(Identity, Owner);

        RasterizeCooperative(Shared, SharedIdentity);

        // Clear the owner's bit (across whichever of the ballot's four 32-bit words holds it) so the next iteration advances to the next large
        // triangle. The computation is identical on every lane (Owner is uniform), so the ballot stays consistent across the subgroup.
        uint Word = Owner >> 5u;          // which of the 4 uvec4 components
        uint Bit  = Owner & 31u;          // bit within that component
        if (Word == 0u) LargeBallot.x &= ~(1u << Bit);
        else if (Word == 1u) LargeBallot.y &= ~(1u << Bit);
        else if (Word == 2u) LargeBallot.z &= ~(1u << Bit);
        else                 LargeBallot.w &= ~(1u << Bit);
    }
}
