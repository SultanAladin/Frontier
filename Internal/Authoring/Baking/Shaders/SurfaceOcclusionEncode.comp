#version 450

// 🧩 The bent-normal / thickness encoder (the ray-traced surface pass). One invocation per texel of the Edge × Edge map. For each covered
//    texel it fires a deterministic golden-angle hemisphere fan of SecondaryRays about the surface normal (bent) or the inward -N axis
//    (thickness), cone-limited by SpreadAngle, and traces each ray against the uploaded triangle ray volume with an explicit-stack
//    Möller–Trumbore descent (GLSL has no recursion). Bent normal averages the unoccluded directions (any-hit); thickness averages the
//    forward hit distance (closest-hit, escaped rays count as maximally thick) and inverts so thin reads bright. Branches on the push
//    Identity. Mirrors EncodeBentNormalMap / EncodeThicknessMap (NormalMapBaker.cpp) — same golden-angle fan, bias, and traversal.
// 📝 Bindings: 0 the texel field, 1 the ray triangles, 2 the tree elements, 3 the leaf-ordered index list, 4 the RGBA pixel output. Push
//    carries the edge, identity, ray-volume counts, and the trace controls.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct TexelSample
{
    vec4 WorldPosition;
    vec4 SurfaceNormal;
    vec4 TangentBasisT;
    vec4 TangentBasisB;
    int  TriangleIndex;
    uint CoverageMask;
    uint Pad0;
    uint Pad1;
};

// std430, byte-identical to GpuRayTriangle (GpuBakeDispatch.cpp).
struct RayTriangle
{
    vec4 CornerA;
    vec4 CornerB;
    vec4 CornerC;
    vec4 FaceNormal;
    vec4 VertexNormalA;
    vec4 VertexNormalB;
    vec4 VertexNormalC;
    vec4 BoundaryMinimum;
    vec4 BoundaryMaximum;
};

// std430, byte-identical to GpuRayElement (GpuBakeDispatch.cpp).
struct RayElement
{
    vec4 BoundaryMinimum;
    vec4 BoundaryMaximum;
    int  FirstTriangle;
    int  TriangleCount;
    int  LeftChild;
    int  RightChild;
};

layout(std430, set = 0, binding = 0) readonly buffer TexelField      { TexelSample Texels[]; };
layout(std430, set = 0, binding = 1) readonly buffer TriangleList    { RayTriangle Triangles[]; };
layout(std430, set = 0, binding = 2) readonly buffer ElementList     { RayElement  Elements[]; };
layout(std430, set = 0, binding = 3) readonly buffer OrderedList     { int         OrderedIndices[]; };
layout(std430, set = 0, binding = 4) writeonly buffer PixelImage     { uint        Pixels[]; };

layout(push_constant) uniform SurfaceConstant
{
    uint  Edge;
    uint  Identity;           // 2 BentNormal, 4 Thickness (SurfaceMapIdentity)
    uint  TriangleCount;
    uint  ElementCount;
    int   SecondaryRays;
    float SpreadAngle;
    float OcclusionMaximum;
    float SamplingRadius;
    float Contrast;
    uint  PositionNormalize;
    uint  AutoTonemapEnabled;
    vec4  BoundsMinimum;
    vec4  BoundsMaximum;
} Surface;

const uint  IdentityBentNormal = 2u;
const uint  IdentityThickness  = 4u;
const float PiValue = 3.14159265358979323846;
const int   StackDepth = 64;   // ample for a median-split tree over any bake mesh (leaf threshold 8)

uint EncodeSignedChannel(float Component)
{
    return uint(clamp(Component * 0.5 + 0.5, 0.0, 1.0) * 255.0 + 0.5);
}

uint EncodeUnitScalar(float Value)
{
    return uint(clamp(Value, 0.0, 1.0) * 255.0 + 0.5);
}

uint PackPixel(uint R, uint G, uint B, uint A)
{
    return (R & 0xFFu) | ((G & 0xFFu) << 8) | ((B & 0xFFu) << 16) | ((A & 0xFFu) << 24);
}

vec3 ReciprocalDirection(vec3 Direction)
{
    // Guarded reciprocal for the slab test: a near-zero component becomes a large finite so its slab is effectively unbounded.
    vec3 Result;
    Result.x = abs(Direction.x) < 1e-20 ? sign(Direction.x == 0.0 ? 1.0 : Direction.x) * 1e20 : 1.0 / Direction.x;
    Result.y = abs(Direction.y) < 1e-20 ? sign(Direction.y == 0.0 ? 1.0 : Direction.y) * 1e20 : 1.0 / Direction.y;
    Result.z = abs(Direction.z) < 1e-20 ? sign(Direction.z == 0.0 ? 1.0 : Direction.z) * 1e20 : 1.0 / Direction.z;
    return Result;
}

// Ray / AABB slab test — the near entry parameter (clamped to 0) when the ray meets the box within [0, MaximumDistance], else a large
// sentinel so the traversal skips the branch. Mirrors IntersectRayBoundary.
float IntersectRayBoundary(vec3 Origin, vec3 InverseDirection, vec3 Minimum, vec3 Maximum, float MaximumDistance)
{
    float NearParameter = 0.0;
    float FarParameter  = MaximumDistance;
    for (int Axis = 0; Axis < 3; ++Axis)
    {
        float EntryParameter = (Minimum[Axis] - Origin[Axis]) * InverseDirection[Axis];
        float ExitParameter  = (Maximum[Axis] - Origin[Axis]) * InverseDirection[Axis];
        if (EntryParameter > ExitParameter) { float Swap = EntryParameter; EntryParameter = ExitParameter; ExitParameter = Swap; }
        NearParameter = max(NearParameter, EntryParameter);
        FarParameter  = min(FarParameter, ExitParameter);
        if (NearParameter > FarParameter) return 3.4e38;
    }
    return NearParameter;
}

// Möller–Trumbore ray / triangle, two-sided. Returns the forward hit distance in (1e-6, MaximumDistance] or -1 on a miss. Mirrors
// IntersectRayTriangle.
float IntersectRayTriangle(vec3 Origin, vec3 Direction, uint TriangleIndex, float MaximumDistance)
{
    RayTriangle Triangle = Triangles[TriangleIndex];
    vec3 CornerA = Triangle.CornerA.xyz;
    vec3 EdgeAB  = Triangle.CornerB.xyz - CornerA;
    vec3 EdgeAC  = Triangle.CornerC.xyz - CornerA;
    vec3 PVector = cross(Direction, EdgeAC);
    float Determinant = dot(EdgeAB, PVector);
    if (abs(Determinant) < 1e-12) return -1.0;

    float InverseDeterminant = 1.0 / Determinant;
    vec3  TVector = Origin - CornerA;
    float WeightB = dot(TVector, PVector) * InverseDeterminant;
    if (WeightB < -1e-6 || WeightB > 1.0 + 1e-6) return -1.0;

    vec3  QVector = cross(TVector, EdgeAB);
    float WeightC = dot(Direction, QVector) * InverseDeterminant;
    if (WeightC < -1e-6 || WeightB + WeightC > 1.0 + 1e-6) return -1.0;

    float Distance = dot(EdgeAC, QVector) * InverseDeterminant;
    if (Distance <= 1e-6 || Distance > MaximumDistance) return -1.0;
    return Distance;
}

// Is any triangle hit within (0, MaximumDistance]? Explicit-stack tree descent (mirrors DescendAnyHit, depth-first left then right).
bool TraverseAnyHit(vec3 Origin, vec3 Direction, vec3 InverseDirection, float MaximumDistance)
{
    if (Surface.ElementCount == 0u) return false;
    int Stack[StackDepth];
    int StackTop = 0;
    Stack[StackTop++] = 0;
    while (StackTop > 0)
    {
        int ElementIndex = Stack[--StackTop];
        RayElement Element = Elements[ElementIndex];
        if (IntersectRayBoundary(Origin, InverseDirection, Element.BoundaryMinimum.xyz, Element.BoundaryMaximum.xyz, MaximumDistance) >= MaximumDistance)
            continue;
        if (Element.LeftChild < 0)
        {
            for (int Local = 0; Local < Element.TriangleCount; ++Local)
            {
                uint TriangleIndex = uint(OrderedIndices[Element.FirstTriangle + Local]);
                if (IntersectRayTriangle(Origin, Direction, TriangleIndex, MaximumDistance) > 0.0) return true;
            }
            continue;
        }
        if (StackTop + 2 <= StackDepth)
        {
            Stack[StackTop++] = Element.LeftChild;
            Stack[StackTop++] = Element.RightChild;
        }
    }
    return false;
}

// Nearest forward hit distance within (0, MaximumDistance], or MaximumDistance when the ray escapes. Explicit-stack descent that shrinks
// the working distance as it finds closer hits (mirrors DescendClosestHit; the ordered near-child recursion becomes a plain stack push —
// pruning against the shrinking BestDistance keeps it exact).
float TraverseClosestHit(vec3 Origin, vec3 Direction, vec3 InverseDirection, float MaximumDistance)
{
    float BestDistance = MaximumDistance;
    if (Surface.ElementCount == 0u) return BestDistance;
    int Stack[StackDepth];
    int StackTop = 0;
    Stack[StackTop++] = 0;
    while (StackTop > 0)
    {
        int ElementIndex = Stack[--StackTop];
        RayElement Element = Elements[ElementIndex];
        if (IntersectRayBoundary(Origin, InverseDirection, Element.BoundaryMinimum.xyz, Element.BoundaryMaximum.xyz, BestDistance) >= BestDistance)
            continue;
        if (Element.LeftChild < 0)
        {
            for (int Local = 0; Local < Element.TriangleCount; ++Local)
            {
                uint TriangleIndex = uint(OrderedIndices[Element.FirstTriangle + Local]);
                float Distance = IntersectRayTriangle(Origin, Direction, TriangleIndex, BestDistance);
                if (Distance > 0.0 && Distance < BestDistance) BestDistance = Distance;
            }
            continue;
        }
        if (StackTop + 2 <= StackDepth)
        {
            Stack[StackTop++] = Element.LeftChild;
            Stack[StackTop++] = Element.RightChild;
        }
    }
    return BestDistance;
}

void main()
{
    uvec2 Coordinate = gl_GlobalInvocationID.xy;
    if (Coordinate.x >= Surface.Edge || Coordinate.y >= Surface.Edge) return;
    uint TexelIndex = Coordinate.y * Surface.Edge + Coordinate.x;

    TexelSample Texel = Texels[TexelIndex];
    bool Bent = Surface.Identity == IdentityBentNormal;

    if (Texel.CoverageMask == 0u)
    {
        // Gutter: bent takes the neutral flat-blue background; thickness the neutral mid-grey.
        Pixels[TexelIndex] = Bent ? PackPixel(128u, 128u, 255u, 255u) : PackPixel(128u, 128u, 128u, 255u);
        return;
    }

    int   RayCount  = Surface.SecondaryRays < 1 ? 1 : Surface.SecondaryRays;
    float ConeLimit = cos(clamp(Surface.SpreadAngle, 0.0, 90.0) * PiValue / 180.0);
    float MaximumDistance = Surface.OcclusionMaximum > 1e-4 ? Surface.OcclusionMaximum : 1.0;
    float GoldenAngle = PiValue * (3.0 - sqrt(5.0));
    float OriginBias = MaximumDistance * 1e-3 + 1e-4;

    vec3 Normal = Texel.SurfaceNormal.xyz;
    float NormalLength = length(Normal);
    if (NormalLength > 1e-8) Normal /= NormalLength;

    vec3 TangentT = Texel.TangentBasisT.xyz;
    vec3 TangentB = Texel.TangentBasisB.xyz;

    // Bent spins about +N; thickness about the inward -N axis. Both offset the origin along that axis to escape self-intersection.
    vec3 Axis = Bent ? Normal : -Normal;
    vec3 Origin = Texel.WorldPosition.xyz + Axis * OriginBias;

    vec3 Accum = vec3(0.0);
    int  Unoccluded = 0;
    float DistanceAccum = 0.0;
    int   HitCount = 0;

    for (int Sample = 0; Sample < RayCount; ++Sample)
    {
        float Fraction01 = (float(Sample) + 0.5) / float(RayCount);
        float CosineTheta = 1.0 - Fraction01 * (1.0 - ConeLimit);
        float SineTheta = sqrt(max(0.0, 1.0 - CosineTheta * CosineTheta));
        float Phi = float(Sample) * GoldenAngle;

        float LocalX = cos(Phi) * SineTheta;
        float LocalY = sin(Phi) * SineTheta;
        float LocalZ = CosineTheta;   // along the spin axis

        vec3 Direction = TangentT * LocalX + TangentB * LocalY + Axis * LocalZ;
        float DirLength = length(Direction);
        if (DirLength > 1e-8) Direction /= DirLength;
        vec3 InverseDirection = ReciprocalDirection(Direction);

        if (Bent)
        {
            if (!TraverseAnyHit(Origin, Direction, InverseDirection, MaximumDistance))
            {
                Accum += Direction;
                ++Unoccluded;
            }
        }
        else
        {
            float Distance = TraverseClosestHit(Origin, Direction, InverseDirection, MaximumDistance);
            // A ray that escapes reports the surface is locally as thick as we care to measure (Distance == MaximumDistance here).
            DistanceAccum += Distance;
            ++HitCount;
        }
    }

    if (Bent)
    {
        vec3 Direction = Normal;
        if (Unoccluded > 0)
        {
            float AccumLength = length(Accum);
            if (AccumLength > 1e-6) Direction = Accum / AccumLength;
        }
        uint R = EncodeSignedChannel(Direction.x);
        uint G = EncodeSignedChannel(Direction.y);
        uint B = EncodeSignedChannel(Direction.z);
        Pixels[TexelIndex] = PackPixel(R, G, B, 255u);
    }
    else
    {
        float MeanDistance = HitCount > 0 ? DistanceAccum / float(HitCount) : MaximumDistance;
        float Thickness = clamp(1.0 - MeanDistance / MaximumDistance, 0.0, 1.0);
        uint Grey = EncodeUnitScalar(Thickness);
        Pixels[TexelIndex] = PackPixel(Grey, Grey, Grey, 255u);
    }
}
