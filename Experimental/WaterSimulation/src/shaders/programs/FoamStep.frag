#version 300 es
precision highp float;

#include "Common.glsl"
#include "TerrainSampling.glsl"

uniform sampler2D uFoamField;
uniform sampler2D uHeightSource;
uniform vec2  uDomain;
uniform float uResolution;
uniform float uTexelWorld;
uniform float uDeltaSeconds;
uniform float uDecaySeconds;
uniform float uBreakSensitivity;
uniform float uShoreFoam;
uniform float uShoreBand;
uniform float uAdvectionScale;
uniform vec2  uWindDirection;
uniform float uWindSpeed;

out vec4 FragColor;

// 🧩 Global foam grid: advected by the surface flow, generated by breaking curvature and the shoreline
void main()
{
    vec2 Coordinate = gl_FragCoord.xy / float(uResolution);
    vec2 Step = vec2(1.0 / float(uResolution), 0.0);
    vec2 StepVertical = vec2(0.0, 1.0 / float(uResolution));
    vec2 WorldXz = (Coordinate - 0.5) * uDomain;

    float LeftSample = textureLod(uHeightSource, Coordinate - Step, 0.0).r;
    float RightSample = textureLod(uHeightSource, Coordinate + Step, 0.0).r;
    float DownSample = textureLod(uHeightSource, Coordinate - StepVertical, 0.0).r;
    float UpSample = textureLod(uHeightSource, Coordinate + StepVertical, 0.0).r;
    float Center = textureLod(uHeightSource, Coordinate, 0.0).r;

    vec2 Slope = vec2(RightSample - LeftSample, UpSample - DownSample) / (2.0 * uTexelWorld);
    vec2 Flow = -Slope * uAdvectionScale + uWindDirection * uWindSpeed * 0.03;

    vec2 BackCoordinate = Coordinate - Flow * uDeltaSeconds / uDomain;
    float Advected = textureLod(uFoamField, clamp(BackCoordinate, vec2(0.0), vec2(1.0)), 0.0).r;

    float Decay = exp(-uDeltaSeconds / max(uDecaySeconds, 0.05));
    float Curvature = (LeftSample + RightSample + DownSample + UpSample - 4.0 * Center)
                      / max(uTexelWorld * uTexelWorld, 0.00001);
    float Breaking = Saturate(-Curvature * uBreakSensitivity);

    float Depth = max(SeaLevel - SampleTerrainHeight(WorldXz), 0.0);
    float ShoreBand = 1.0 - smoothstep(0.0, max(uShoreBand, 0.05), Depth);
    float Source = Breaking * 0.9 + ShoreBand * uShoreFoam;

    float NewFoam = Saturate(Advected * Decay + Source * uDeltaSeconds * 5.0);
    NewFoam *= smoothstep(-0.35, 0.35, Depth);

    FragColor = vec4(NewFoam, 0.0, 0.0, 1.0);
}
