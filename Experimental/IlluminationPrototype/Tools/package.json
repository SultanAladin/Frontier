{
  "name": "illumination-host-tools",
  "private": true,
  "type": "module",
  "description": "Headless validation and software rendering of the IlluminationHost exhibit through Dawn (webgpu).",
  "scripts": {
    "validate": "node HeadlessHarness.mjs .. 12 \"?capture=1\"",
    "test": "node --test *.test.mjs",
    "test:stability": "node VehicleStability.mjs ..",
    "validate:effects": "HOOKS=VehicleEffectsHooks.mjs node HeadlessHarness.mjs .. 36 \"?capture=1\"",
    "validate:slate": "HOOKS=SlateIntegrationHooks.mjs node HeadlessHarness.mjs .. 48 \"?capture=1\"",
    "validate:orbit": "HOOKS=VehicleOrbitHooks.mjs node HeadlessHarness.mjs .. 30 \"?capture=1\"",
    "validate:combined": "HOOKS=CombinedFeaturesHooks.mjs node HeadlessHarness.mjs .. 24 \"?capture=1&quality=low\"",
    "validate:browser": "node BrowserEnvironment.mjs",
    "compare:tyres": "node CompareTyreTiming.mjs"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "esbuild": "0.25.12",
    "playwright-core": "1.64.1",
    "webgpu": "0.6.2"
  }
}
