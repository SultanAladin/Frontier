@@ -12755,8 +12761,17 @@
 {
     ImVec2 scroll = window->Scroll;
     ImVec2 decoration_size(window->DecoOuterSizeX1 + window->DecoInnerSizeX1 + window->DecoOuterSizeX2, window->DecoOuterSizeY1 + window->DecoInnerSizeY1 + window->DecoOuterSizeY2);
+    // [FRONTIER PATCH H] Smooth scrolling with overscroll: the position eases toward its target with
+    //   a short physical lag instead of snapping, and may travel a little past either end before
+    //   springing back. Begin() no longer clears ScrollTarget; a target retires here only once the
+    //   eased position settles on it, and an out-of-range target settles on the overshoot first and
+    //   then retargets the boundary so the surface bounces home on the following frames.
+    const float frontier_dt = (GImGui->IO.DeltaTime > 0.0f) ? ImClamp(GImGui->IO.DeltaTime, 0.001f, 0.05f) : (1.0f / 60.0f);
+    const float frontier_alpha = ImClamp(frontier_dt * 16.0f, 0.05f, 1.0f);
+    const float frontier_overscroll = 56.0f;
     for (int axis = 0; axis < 2; axis++)
     {
+        const float visible_size = window->SizeFull[axis] - decoration_size[axis];
         if (window->ScrollTarget[axis] < FLT_MAX)
         {
             float center_ratio = window->ScrollTargetCenterRatio[axis];
@@ -12767,11 +12782,41 @@
                 float snap_max = window->ScrollMax[axis] + window->SizeFull[axis] - decoration_size[axis];
                 scroll_target = CalcScrollEdgeSnap(scroll_target, snap_min, snap_max, window->ScrollTargetEdgeSnapDist[axis], center_ratio);
             }
-            scroll[axis] = scroll_target - center_ratio * (window->SizeFull[axis] - decoration_size[axis]);
+            float desired = ImClamp(scroll_target - center_ratio * visible_size, -frontier_overscroll, window->ScrollMax[axis] + frontier_overscroll);
+            const float settled_from = scroll[axis];
+            float eased = settled_from + (desired - settled_from) * frontier_alpha;
+            if (ImAbs(desired - eased) <= 1.0f)
+                eased = desired;
+            else if (ImRound64(eased) == ImRound64(settled_from))
+                eased = settled_from + (desired > settled_from ? 1.0f : -1.0f); // never stall a pixel short
+            scroll[axis] = eased;
+            if (eased == desired)
+            {
+                if (desired < 0.0f)
+                    window->ScrollTarget[axis] = center_ratio * visible_size; // spring back to 0
+                else if (desired > window->ScrollMax[axis])
+                    window->ScrollTarget[axis] = window->ScrollMax[axis] + center_ratio * visible_size; // spring back to max
+                else
+                    window->ScrollTarget[axis] = FLT_MAX;
+            }
+        }
+        else if (!window->Collapsed && !window->SkipItems && (scroll[axis] < 0.0f || scroll[axis] > window->ScrollMax[axis]))
+        {
+            // Content shrank beneath an overshot position: glide back inside instead of jumping.
+            const float bound = ImClamp(scroll[axis], 0.0f, window->ScrollMax[axis]);
+            scroll[axis] += (bound - scroll[axis]) * frontier_alpha;
+            if (ImAbs(bound - scroll[axis]) <= 1.0f)
+                scroll[axis] = bound;
+            else
+            {
+                window->ScrollTarget[axis] = bound;
+                window->ScrollTargetCenterRatio[axis] = 0.0f;
+                window->ScrollTargetEdgeSnapDist[axis] = 0.0f;
+            }
         }
-        scroll[axis] = ImRound64(ImMax(scroll[axis], 0.0f));
+        scroll[axis] = ImRound64(ImMax(scroll[axis], -frontier_overscroll));
         if (!window->Collapsed && !window->SkipItems)
-            scroll[axis] = ImMin(scroll[axis], window->ScrollMax[axis]);
+            scroll[axis] = ImMin(scroll[axis], window->ScrollMax[axis] + frontier_overscroll);
     }
     return scroll;
 }
